<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:local="clr-namespace:Firefly.Client.Control">

    <Style x:Key="DefaultClosableLabelStyle" TargetType="{x:Type local:ClosableLabel}">
        <Setter Property="Foreground" Value="{DynamicResource IRtek.Brushes.ThemeForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ClosableLabel}">
                    <Border
                        x:Name="border"
                        Height="38"
                        BorderBrush="#993B4459"
                        BorderThickness="1,1,1,0"
                        SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="#1443506C" />
                                <GradientStop Offset="1" Color="#993B4459" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel
                                Margin="20,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <ContentPresenter
                                    x:Name="ControlIcon"
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}"
                                    Focusable="False" />
                                <TextBlock
                                    x:Name="tbContent"
                                    Margin="6,0,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource NormalFontSize}"
                                    Text="{TemplateBinding Content}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{TemplateBinding Content}" />
                            </StackPanel>
                            <amur:Button
                                x:Name="btnClose"
                                Width="16"
                                Height="16"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <amur:Button.Icon>
                                    <amur:FontIcon
                                        FontFamily="{DynamicResource SegoeFluentIcons}"
                                        FontSize="12"
                                        Glyph="&#xe8bb;" />
                                </amur:Button.Icon>
                            </amur:Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanClose" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="btnClose" Property="Visibility" Value="Visible" />
                            <Setter TargetName="btnClose" Property="MouseOverBackground" Value="{DynamicResource IRtek.Brushes.WindowButton.Background.MouseOver}" />
                        </MultiTrigger>
                        <Trigger SourceName="tbContent" Property="Text" Value="{x:Null}">
                            <Setter TargetName="tbContent" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger SourceName="tbContent" Property="Text" Value="">
                            <Setter TargetName="tbContent" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#146B7999" />
                                        <GradientStop Offset="1" Color="#9967728B" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#54617B" />
                                        <GradientStop Offset="1" Color="#2A3246" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource IRtek.Brushes.ThemeForeground.Highlight}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Height" Value="46" />
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#54617B" />
                                        <GradientStop Offset="1" Color="#2A3246" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource IRtek.Brushes.ThemeForeground.Highlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultClosableLabelStyle}" TargetType="{x:Type local:ClosableLabel}" />
</ResourceDictionary>