<Window
    x:Class="Firefly.Client.Control.IRtekMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Width="330"
    MinWidth="330"
    MinHeight="180"
    AllowsTransparency="False"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    Style="{StaticResource DialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <amurControls:IRtekWindowHeader
            x:Name="title"
            Title="{Binding ElementName=root, Path=Caption}"
            DockPanel.Dock="Top" />
        <StackPanel
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnOK"
                Height="28"
                Margin="{DynamicResource RightBottomMargin}"
                Click="btnOK_Click"
                Content="{x:Static lang:Resources.OK}"
                IsDefault="True"
                Style="{StaticResource IRtek.Styles.Button.Classic}" />
            <Button
                x:Name="btnYes"
                Height="28"
                Margin="{DynamicResource RightBottomMargin}"
                Click="btnYes_Click"
                Content="{x:Static lang:Resources.Yes}"
                Style="{StaticResource IRtek.Styles.Button.Classic}" />
            <Button
                x:Name="btnCancel"
                Height="28"
                Margin="{DynamicResource RightBottomMargin}"
                Click="btnCancel_Click"
                Content="{x:Static lang:Resources.Cancel}"
                Style="{StaticResource IRtek.Styles.Button.Classic}" />
            <Button
                x:Name="btnNo"
                Height="28"
                Margin="{DynamicResource RightBottomMargin}"
                Click="btnNo_Click"
                Content="{x:Static lang:Resources.No}"
                Style="{StaticResource IRtek.Styles.Button.Classic}" />
        </StackPanel>
        <Grid DockPanel.Dock="Top">
            <StackPanel
                Margin="{StaticResource NormalMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    x:Name="imgIcon"
                    Margin="{StaticResource NormalMargin}"
                    Source="{Binding ElementName=root, Path=ImageIcon}" />
                <TextBlock
                    Width="300"
                    Margin="{StaticResource NormalMargin}"
                    Text="{Binding ElementName=root, Path=MessageBoxText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
