<Window
    x:Class="Firefly.Client.Control.IRtekWaitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Width="254"
    AllowsTransparency="False"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    Closed="root_Closed"
    Loaded="root_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource DialogWindow}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="254" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            x:Name="PART_LoadImage"
            Width="200"
            Height="200"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            amurControls:ImageBehavior.AnimatedSource="pack://application:,,,/Firefly.Client.Control;component/Resources/load.gif" />
        <TextBlock
            x:Name="PART_ProgressText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="32"
            Foreground="#EDF1FD" />

        <TextBlock
            x:Name="PART_Cancel"
            Grid.Row="1"
            Margin="0,-24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            LineHeight="70"
            Visibility="Visible">
            <Hyperlink Click="hCancel_Click" FontSize="22">
                <Run Text="{x:Static lang:Resources.CancelLoad}" />
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
