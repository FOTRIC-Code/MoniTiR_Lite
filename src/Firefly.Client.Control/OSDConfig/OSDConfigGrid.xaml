<Grid x:Class="Firefly.Client.Control.OSDConfigGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Firefly.Client.Control">
    <Grid>
        <local:ImageCanvas x:Name="PART_imageCanvas" Width="640" Height="480" />
        <local:CharacterThumb x:Name="PART_channel" Visibility="{Binding EnableOSD,Converter={StaticResource BoolToVisibilityConverter}}" PositionChanged="CharacterThumb_PositionChanged" />
        <local:CharacterThumb x:Name="PART_time" Visibility="{Binding EnableOSD,Converter={StaticResource BoolToVisibilityConverter}}" PositionChanged="CharacterThumb_PositionChanged" />
        <local:CharacterThumb x:Name="PART_ptz" Visibility="{Binding EnableOSD,Converter={StaticResource BoolToVisibilityConverter}}" PositionChanged="CharacterThumb_PositionChanged" />
    </Grid>
</Grid>