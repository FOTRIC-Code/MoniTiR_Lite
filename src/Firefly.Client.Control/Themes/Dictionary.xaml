    <Style x:Key="DialogWindow" TargetType="{x:Type Window}">
        <Setter Property="BorderBrush" Value="{StaticResource IRtek.Brushes.Window.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}" />
        <Setter Property="Foreground" Value="{StaticResource IRtek.Brushes.ThemeForeground}" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontStretch" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
    </Style>

    <Style x:Key="ResizableDialogWindow" TargetType="{x:Type Window}">
        <Setter Property="BorderBrush" Value="{StaticResource IRtek.Brushes.Window.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}" />
        <Setter Property="Foreground" Value="{StaticResource IRtek.Brushes.ThemeForeground}" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontStretch" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
        <Setter Property="MaxWidth" Value="{x:Static control:UIConstants.MAX_WINDOW_WIDTH}" />
        <Setter Property="MaxHeight" Value="{x:Static control:UIConstants.MAX_WINDOW_HEIGHT}" />
    </Style>

    <Style x:Key="ResizableWindow" TargetType="{x:Type Window}">
        <Setter Property="BorderBrush" Value="{StaticResource IRtek.Brushes.Window.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}" />
        <Setter Property="Foreground" Value="{StaticResource IRtek.Brushes.ThemeForeground}" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontStretch" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="{StaticResource ControlBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="60" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="brdMenuItem"
                            Grid.Column="0"
                            Grid.ColumnSpan="2" />
                        <Image
                            x:Name="imgIcon"
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="{StaticResource NormalMargin}"
                            Source="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="tbkHeader"
                            Grid.Column="1"
                            Margin="{StaticResource NormalMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Path
                            x:Name="pthHasItems"
                            Grid.Column="1"
                            Margin="{StaticResource NormalMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Data="M0,4 4,0 0,-4 z"
                            Fill="{StaticResource ControlDarkBrush}"
                            Visibility="Collapsed" />
                        <Popup
                            x:Name="pupSubMenu"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsSubmenuOpen}"
                            Placement="Right">
                            <ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <Border
                                    x:Name="brdSubMenu"
                                    Background="{StaticResource ControlBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="{StaticResource DefaultBorderThickness}"
                                    SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </ScrollViewer>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=imgIcon, Path=Source}" Value="x:Null">
                            <Setter TargetName="imgIcon" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="HasItems" Value="true">
                            <Setter TargetName="pthHasItems" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="brdMenuItem" Property="Background" Value="{StaticResource HighLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.DataGrid.Classic}" TargetType="DataGrid">
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.DataGridColumnHeader.Classic}" TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.DataGridRow.Classic}" TargetType="DataGridRow">
        <Setter Property="Height" Value="50" />
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.DataGridCell.Classic}" TargetType="DataGridCell">
        <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
