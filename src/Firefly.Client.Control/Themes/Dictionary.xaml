    <Style BasedOn="{StaticResource IRtek.Styles.TreeView.Classic}" TargetType="TreeView" />

    <Style TargetType="UserControl">
        <!--<Setter Property="Background" Value="{StaticResource ControlBrush}"></Setter>-->
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.ToolBarTray.Classic}" TargetType="ToolBarTray">
        <!--<Setter Property="Background" Value="{StaticResource ControlBrush}" />-->
    </Style>

    <Style BasedOn="{StaticResource IRtek.Styles.ToolBar.Classic}" TargetType="ToolBar">
        <!--<Setter Property="Background" Value="{StaticResource ControlBrush}" />-->
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource SourceHanLight}" />
