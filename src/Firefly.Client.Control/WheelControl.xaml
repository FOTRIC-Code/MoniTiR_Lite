<UserControl
    x:Class="Firefly.Client.Control.WheelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="170"
    Height="170"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Canvas>
                            <amur:SymbolIcon
                                x:Name="icon"
                                Canvas.Left="6"
                                Filled="True"
                                Symbol="Triangle20" />
                            <Polygon
                                x:Name="bgMoveUp"
                                Points="-26,0 57,0 15.5,90 -26,0"
                                Visibility="Collapsed">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#004E5B7C" />
                                        <GradientStop Offset="1" Color="#3569EB" />
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>
                        </Canvas>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgMoveUp" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Highlight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="icon" Property="Opacity" Value="{StaticResource DefaultDisableOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Viewbox>
        <Grid Width="170" Height="170">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#383F53" />
                            <GradientStop Offset="1" Color="#171C28" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="100" Height="100">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#171C28" />
                            <GradientStop Offset="1" Color="#363D50" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="36" Height="36">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#383F53" />
                            <GradientStop Offset="1" Color="#171C28" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <UniformGrid
                Margin="{DynamicResource NormalMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Columns="3"
                Rows="3">
                <Rectangle />
                <Button
                    x:Name="btnMoveU"
                    Width="31"
                    Height="25.66"
                    VerticalAlignment="Top"
                    controls:ButtonAssist.SVGHeight="31"
                    controls:ButtonAssist.SVGWidth="31"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                    Tag="Up" />
                <Rectangle />
                <Button
                    x:Name="btnMoveL"
                    Width="31"
                    Height="31"
                    MinWidth="31"
                    MinHeight="31"
                    HorizontalAlignment="Left"
                    controls:ButtonAssist.SVGHeight="31"
                    controls:ButtonAssist.SVGWidth="31"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                    Tag="Left">
                    <Button.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="15.5" CenterY="15.5" />
                    </Button.RenderTransform>
                </Button>
                <Rectangle />
                <Button
                    x:Name="btnMoveR"
                    Width="31"
                    Height="31"
                    MinWidth="31"
                    MinHeight="31"
                    HorizontalAlignment="Right"
                    controls:ButtonAssist.SVGHeight="31"
                    controls:ButtonAssist.SVGWidth="31"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                    Tag="Right">
                    <Button.RenderTransform>
                        <RotateTransform Angle="90" CenterX="15.5" CenterY="15.5" />
                    </Button.RenderTransform>
                </Button>
                <Rectangle />
                <Button
                    x:Name="btnMoveD"
                    Width="31"
                    Height="31"
                    MinWidth="31"
                    MinHeight="31"
                    VerticalAlignment="Bottom"
                    controls:ButtonAssist.SVGHeight="31"
                    controls:ButtonAssist.SVGWidth="31"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                    Tag="Down">
                    <Button.RenderTransform>
                        <RotateTransform Angle="180" CenterX="15.5" CenterY="15.5" />
                    </Button.RenderTransform>
                </Button>
                <Rectangle />
            </UniformGrid>
            <Ellipse
                Grid.Column="1"
                Width="18"
                Height="18"
                Fill="{DynamicResource IRtek.Brushes.ThemeForeground}" />
        </Grid>
    </Viewbox>

</UserControl>
