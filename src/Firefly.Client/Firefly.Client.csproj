  <ItemGroup />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    In-proc Fire: copy src\Lib (vendored Infrastructure runtime) + FireMonitor build output ? $(OutputPath).
    C-class (Client-owned): never overwrite from Lib ? FFmpeg.AutoGen / Newtonsoft.Json.
    Firefly.Device.FireMonitor.dll always comes from its project output, not Lib.
    FFmpeg natives live only under Lib\FFmpeg\ ? OutputPath\FFmpeg\ (shared by Client RTSP and Stream.Core).
    Hikvision NVR natives live under Lib\HCNetSDK\ ? OutputPath\HCNetSDK\ (DllImport .\HCNetSDK\HCNetSDK.dll).
  -->
  <PropertyGroup>
    <FireLib>..\Lib</FireLib>
  </PropertyGroup>
  <!-- VS Fast Up-to-date Check ignores AfterTargets=Build when project sources are unchanged;
       Lib DLL drops (e.g. RTSPServer.dll) would otherwise never trigger a copy. -->
  <ItemGroup Condition="Exists('$(FireLib)')">
    <UpToDateCheckInput Include="..\Lib\HCNetSDK\HCNetSDKCom\AudioRender.dll" />
    <UpToDateCheckInput Include="..\Lib\HCNetSDK\libeay32.dll" />
    <UpToDateCheckInput Include="..\Lib\HCNetSDK\OpenAL32.dll" />
    <UpToDateCheckInput Include="..\Lib\HCNetSDK\ssleay32.dll" />
    <UpToDateCheckInput Include="..\Lib\log4net.config" />
    <UpToDateCheckInput Include="..\Firefly.Device.FireMonitor\bin\$(Platform)\$(Configuration)\Firefly.Device.FireMonitor.dll" />
    <UpToDateCheckInput Include="..\Firefly.Device.FireMonitor\bin\$(Configuration)\Firefly.Device.FireMonitor.dll" />
  </ItemGroup>
  <Target Name="CopyFireInProcDependencies" AfterTargets="Build" Condition="Exists('$(FireLib)')">
    <!-- Resolve after FireMonitor has built. Project-level Exists() ran too early on Clean+Rebuild. -->
    <PropertyGroup>
      <_FireMonitorDll>Firefly.Device.FireMonitor.dll</_FireMonitorDll>
      <FireMonitorOut Condition="Exists('..\Firefly.Device.FireMonitor\bin\$(Platform)\$(Configuration)\$(_FireMonitorDll)')">..\Firefly.Device.FireMonitor\bin\$(Platform)\$(Configuration)</FireMonitorOut>
      <FireMonitorOut Condition="'$(FireMonitorOut)' == '' and Exists('..\Firefly.Device.FireMonitor\bin\$(Configuration)\$(_FireMonitorDll)')">..\Firefly.Device.FireMonitor\bin\$(Configuration)</FireMonitorOut>
      <FireMonitorOut Condition="'$(FireMonitorOut)' == '' and Exists('..\Firefly.Device.FireMonitor\bin\$(Configuration)\net461\$(_FireMonitorDll)')">..\Firefly.Device.FireMonitor\bin\$(Configuration)\net461</FireMonitorOut>
    </PropertyGroup>
    <Error Text="Firefly.Device.FireMonitor.dll not found under bin\$(Platform)\$(Configuration) or bin\$(Configuration). In-proc Fire will stay offline; rebuild Firefly.Device.FireMonitor before Client." Condition="'$(FireMonitorOut)' == ''" />
    <ItemGroup>
      <_FireMonitorOut Include="$(FireMonitorOut)\$(_FireMonitorDll)" />
      <_FireMonitorOut Include="$(FireMonitorOut)\FireMonitorRTSPServerConfig.json" Condition="Exists('$(FireMonitorOut)\FireMonitorRTSPServerConfig.json')" />
      <!-- Root + recursive: root Explicit so Lib\RTSPServer.dll etc. are never missed.
           Exclude managed C-class / engine self; natives under FFmpeg\ copy via RecursiveDir. -->
      <_FireLibDll Include="$(FireLib)\*.dll;$(FireLib)\**\*.dll" Exclude="$(FireLib)\FFmpeg.AutoGen.dll;$(FireLib)\Newtonsoft.Json.dll;$(FireLib)\Firefly.Device.FireMonitor.dll;$(FireLib)\avcodec-*.dll;$(FireLib)\avdevice-*.dll;$(FireLib)\avfilter-*.dll;$(FireLib)\avformat-*.dll;$(FireLib)\avutil-*.dll;$(FireLib)\swresample-*.dll;$(FireLib)\swscale-*.dll" />
      <_FireLibConfig Include="$(FireLib)\log4net.config" Condition="Exists('$(FireLib)\log4net.config')" />
      <!-- Fallback only when Lib\FFmpeg is empty: Control ships natives under FFmpeg\x64. -->
      <_ClientFFmpegX64 Include="..\Firefly.Client.Control\FFmpeg\x64\*.dll" Condition="Exists('..\Firefly.Client.Control\FFmpeg\x64')" />
    </ItemGroup>
    <Warning Text="src\Lib has no DLLs under $(FireLib); in-proc Fire engines will be incomplete." Condition="'@(_FireLibDll)' == ''" />
    <Copy SourceFiles="@(_FireMonitorOut)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FireLibDll)" DestinationFiles="@(_FireLibDll->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" Condition="'@(_FireLibDll)' != ''" />
    <Copy SourceFiles="@(_FireLibConfig)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" Condition="'@(_FireLibConfig)' != ''" />
    <!-- If Lib has no FFmpeg\ folder, seed OutputPath\FFmpeg from Control's x64 natives. -->
    <MakeDir Directories="$(OutputPath)FFmpeg" Condition="!Exists('$(FireLib)\FFmpeg') and '@(_ClientFFmpegX64)' != ''" />
    <Copy SourceFiles="@(_ClientFFmpegX64)" DestinationFolder="$(OutputPath)FFmpeg" SkipUnchangedFiles="true" Condition="!Exists('$(FireLib)\FFmpeg') and '@(_ClientFFmpegX64)' != ''" />
  </Target>
  <Target Name="LiteRemoveNonFirePlugins" AfterTargets="AfterBuild">
    <Delete Files="$(OutputPath)Firefly.Client.Control.Equipment.dll" ContinueOnError="true" />
    <Delete Files="$(OutputPath)Firefly.Client.Control.Environment.dll" ContinueOnError="true" />
    <Delete Files="$(OutputPath)Firefly.Client.Control.PDMonitor.dll" ContinueOnError="true" />
  </Target>
</Project>