<Page
    x:Class="Firefly.Client.AlarmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AlarmPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <TabControl
        x:Name="tabAlarm"
        Margin="{DynamicResource BottomMargin}"
        Padding="{DynamicResource LeftTopMargin}"
        TabStripPlacement="Left">
        <client:RealTimeAlarmsControl x:Name="realTimeAlarm" />
        <client:AlarmQueryControl />
    </TabControl>
</Page>
