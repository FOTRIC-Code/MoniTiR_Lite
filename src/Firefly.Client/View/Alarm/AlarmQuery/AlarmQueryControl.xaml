<TabItem
    x:Class="Firefly.Client.AlarmQueryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon AlarmQuery}"
    d:DataContext="{d:DesignInstance client:AlarmQueryViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.AlarmQuery}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <DockPanel>
        <DockPanel
            Width="340"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Menu}"
            DockPanel.Dock="Left">
            <StackPanel
                Margin="{DynamicResource LargeMargin}"
                DockPanel.Dock="Top"
                Orientation="Vertical">
                <TextBlock Text="{x:Static lang:Resources.StartTime}" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <control:EditableDateTime Time="{Binding ViewModel.BeginTime}" />
                <Rectangle Margin="{StaticResource LargeMargin}" />

                <TextBlock Text="{x:Static lang:Resources.EndTime}" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <control:EditableDateTime Time="{Binding ViewModel.EndTime}" />
                <Rectangle Margin="{StaticResource LargeMargin}" />

                <TextBlock Text="{x:Static lang:Resources.ServerAddress}" Visibility="Collapsed" />
                <Rectangle Margin="{StaticResource NormalMargin}" Visibility="Collapsed" />

                <TextBlock Text="{x:Static lang:Resources.AlarmType}" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <control:TreeComboBox ItemsSource="{Binding ViewModel.AlarmTypeOptions}" Text="{Binding ViewModel.DisplayText}" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <TextBlock Text="{x:Static lang:Resources.Status}" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <ComboBox
                    DisplayMemberPath="Text"
                    HorizontalContentAlignment="Left"
                    ItemsSource="{Binding ViewModel.AlarmStatusOptions}"
                    SelectedItem="{Binding ViewModel.SelectedAlarmStatusOption}"
                    SelectedValuePath="Value" />
                <Rectangle Margin="{StaticResource NormalMargin}" />

                <Rectangle Margin="{StaticResource LargeMargin}" />
            </StackPanel>
            <Button
                Margin="{DynamicResource LeftRightBottomMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Click="btnSearch_Click"
                Content="{x:Static lang:Resources.Search}"
                DockPanel.Dock="Bottom" />
            <Rectangle DockPanel.Dock="Bottom" />
        </DockPanel>
        <Rectangle Margin="{DynamicResource LeftMargin}" DockPanel.Dock="Left" />
        <Grid x:Name="gridData" DockPanel.Dock="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="32" />
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="350" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.DetailViewVisibility}" Value="False">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>
            <Border
                Height="32"
                Margin="{StaticResource BottomMargin}"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}"
                DockPanel.Dock="Top">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        x:Name="btnExport"
                        amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/export_icon.png"
                        amur:ButtonAssist.ImageHeight="18"
                        amur:ButtonAssist.ImageWidth="18"
                        Click="btnExport_Click"
                        Content="{x:Static lang:Resources.Export}"
                        IsEnabled="{Binding ViewModel.CanExportItem}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        x:Name="btnExportAll"
                        amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/export_icon.png"
                        amur:ButtonAssist.ImageHeight="18"
                        amur:ButtonAssist.ImageWidth="18"
                        Click="btnExportAll_Click"
                        Content="{x:Static lang:Resources.ExportAll}"
                        IsEnabled="{Binding ViewModel.CanExportAll}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
            </Border>
            <DataGrid
                x:Name="dgAlarm"
                Grid.Row="1"
                Margin="{DynamicResource BottomMargin}"
                amur:DataGridAssist.AutoRowNumber="True"
                IsReadOnly="True"
                ItemsSource="{Binding ViewModel.AlarmItems}"
                SelectedItem="{Binding ViewModel.SelectedAlarm}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource IRtek.Styles.DataGridColumnHeader.Classic}" TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Margin" Value="5,0,0,0" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox MinWidth="30" Click="cbSelectAll_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    MinWidth="30"
                                    Margin="{StaticResource LeftMargin}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmDevice}"
                        SortMemberPath="DeviceName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding DeviceName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding ChannelName}"
                        Header="{x:Static lang:Resources.Channel}" />
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmRegion}"
                        SortMemberPath="AlarmRegion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding AlarmRegion}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="200"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmType}"
                        SortMemberPath="AlarmType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding AlarmType}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmLevel}"
                        SortMemberPath="AlarmLevel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding AlarmLevel}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="240"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmDescription}"
                        SortMemberPath="Description">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource FireflyTextBlock}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip DataContext="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=PlacementTarget}">
                                                        <TextBlock
                                                            MaxWidth="600"
                                                            Text="{Binding Text}"
                                                            TextWrapping="Wrap" />
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="120"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.ConfirmState}"
                        SortMemberPath="IsConfirmed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                    <Setter Property="Text" Value="{x:Static lang:Resources.Confirmed}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConfirmed}" Value="False">
                                                    <Setter Property="Text" Value="{x:Static lang:Resources.NoConfirm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        x:Name="AlarmOutputColum"
                        Width="120"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.OutputState}"
                        SortMemberPath="IsExported">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExported}" Value="True">
                                                    <Setter Property="Text" Value="{x:Static lang:Resources.Exported}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExported}" Value="False">
                                                    <Setter Property="Text" Value="{x:Static lang:Resources.NoExport}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="80"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.Note}"
                        SortMemberPath="Note">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding Note}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Note}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="200"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.AlarmTime}"
                        SortMemberPath="AlarmTime">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Text="{Binding AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="100"
                        Header="{x:Static lang:Resources.Playback}"
                        SortMemberPath="HasRecordVideos">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:VideoViewModel}">
                                <Grid>
                                    <amur:Button
                                        Click="btnRecord_Click"
                                        Icon="{amur:SymbolIcon PlayCircle20}"
                                        IsEnabled="{Binding HasRecordVideos}" />
                                    <amur:Button
                                        x:Name="btnOff"
                                        Icon="{amur:SymbolIcon Line20}"
                                        IsEnabled="{Binding HasRecordVideos}"
                                        Visibility="Collapsed">
                                        <amur:Button.RenderTransform>
                                            <RotateTransform Angle="90" CenterX="15" CenterY="13.8" />
                                        </amur:Button.RenderTransform>
                                    </amur:Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasRecordVideos}" Value="False">
                                        <Setter TargetName="btnOff" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border
                Grid.Row="2"
                Height="32"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.SelectMenu}">
                <Grid>
                    <TextBlock Margin="{DynamicResource LeftMargin}" Text="{x:Static lang:Resources.EventDetails}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Height="28"
                            Margin="{StaticResource RightMargin}"
                            HorizontalAlignment="Right"
                            Click="btnConfirm_Click"
                            Content="{x:Static lang:Resources.Confirm}"
                            IsEnabled="{Binding ViewModel.SelectedAlarm.IsConfirmed, Converter={StaticResource ReverseBooleanConverter}, FallbackValue=False, TargetNullValue=False}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <Button
                            Width="36"
                            Height="28"
                            Margin="{DynamicResource RightMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_icon.png"
                            amur:ButtonAssist.ImageHeight="18"
                            amur:ButtonAssist.ImageWidth="18"
                            Click="btnExpand_Click">
                            <Button.Style>
                                <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.DetailViewVisibility}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" CenterX="18" CenterY="14" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ViewModel.DetailViewVisibility}" Value="False">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-180" CenterX="18" CenterY="14" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer
                x:Name="svEventDetail"
                Grid.Row="3"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Content}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock
                                Height="30"
                                Margin="{DynamicResource LeftMargin}"
                                HorizontalAlignment="Left"
                                Text="{x:Static lang:Resources.LivePreview}" />
                            <CheckBox
                                Margin="{DynamicResource RightMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{x:Static lang:Resources.AutoPlay}"
                                IsChecked="{Binding ViewModel.AutoPlayLiveVideo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border BorderThickness="0" DockPanel.Dock="Bottom">
                            <ItemsControl ItemsSource="{Binding ViewModel.SelectedAlarm.LiveVideoViewModels}">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type client:VideoViewModel}">
                                        <control:RTSPClientControl
                                            Width="400"
                                            Height="300"
                                            Margin="{DynamicResource NormalMargin}"
                                            IsPaused="{Binding IsPaused}"
                                            RTSPUrl="{Binding RTSPUrl}" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type client:PlaceHolderViewModel}">
                                        <Border
                                            x:Name="border"
                                            Width="400"
                                            Height="300"
                                            BorderThickness="0">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <Button
                                                    x:Name="btnPlay"
                                                    Width="400"
                                                    Height="300"
                                                    amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/play_icon.png"
                                                    amur:ButtonAssist.ImageHeight="80"
                                                    amur:ButtonAssist.ImageWidth="80"
                                                    Click="btnPlayLiveVideo_Click" />
                                                <TextBlock
                                                    x:Name="tbNoData"
                                                    HorizontalAlignment="Center"
                                                    Text="{x:Static lang:Resources.NoVideo}"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                                <Setter TargetName="btnPlay" Property="Background" Value="{DynamicResource Transparent}" />
                                                <Setter TargetName="btnPlay" Property="BorderThickness" Value="0" />
                                                <Setter TargetName="btnPlay" Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/no_data_icon.png" />
                                                <Setter TargetName="btnPlay" Property="Width" Value="80" />
                                                <Setter TargetName="btnPlay" Property="Height" Value="80" />
                                                <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </DockPanel>
                    <Separator
                        Grid.Column="1"
                        Width="2"
                        Margin="{DynamicResource TopBottomMargin}" />
                    <DockPanel Grid.Column="2">
                        <TextBlock
                            Height="30"
                            Margin="{DynamicResource LeftMargin}"
                            DockPanel.Dock="Top"
                            Text="{x:Static lang:Resources.AlarmPicture}" />
                        <Border BorderThickness="0" DockPanel.Dock="Bottom">
                            <ItemsControl VerticalAlignment="Stretch" ItemsSource="{Binding ViewModel.SelectedAlarm.AlarmPictureList}">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type client:PlaceHolderViewModel}">
                                        <Border
                                            Width="408"
                                            Height="308"
                                            Margin="{DynamicResource NormalMargin}"
                                            BorderThickness="0">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <control:IRtekImage
                                                    x:Name="imgPicture"
                                                    Width="400"
                                                    Height="300"
                                                    Margin="{DynamicResource NormalMargin}"
                                                    AnalyzIRClick="btnAnalyzIR_Click"
                                                    IsEnabled="{Binding IsEnable}"
                                                    Source="{Binding Url}"
                                                    SupportAnalyzIR="{Binding IsIR}" />
                                                <TextBlock
                                                    x:Name="tbNoData"
                                                    HorizontalAlignment="Center"
                                                    Text="{x:Static lang:Resources.NoPicture}"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                                <Setter TargetName="imgPicture" Property="Source" Value="/MoniTiRLite;component/Resources/no_data_icon.png" />
                                                <Setter TargetName="imgPicture" Property="Width" Value="80" />
                                                <Setter TargetName="imgPicture" Property="Height" Value="80" />
                                                <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </DockPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</TabItem>