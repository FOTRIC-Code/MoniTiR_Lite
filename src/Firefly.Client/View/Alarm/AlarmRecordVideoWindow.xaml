<Window
    x:Class="Firefly.Client.AlarmRecordVideoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="AlarmRecordVideoWindow"
    Width="830"
    Height="356"
    MinWidth="830"
    MinHeight="356"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:IRtekWindowHeader Title="{x:Static lang:Resources.Playback}" ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecordVideoList}">
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type client:VideoViewModel}">
                    <control:RTSPClientControl
                        Width="400"
                        Height="300"
                        Margin="{StaticResource NormalMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        IsPaused="{Binding IsPaused}"
                        RTSPUrl="{Binding RTSPUrl}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type client:PlaceHolderViewModel}">
                    <Border
                        Width="400"
                        Height="300"
                        Margin="{DynamicResource LeftMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        CornerRadius="4">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Button
                                x:Name="btnPlay"
                                Width="400"
                                Height="300"
                                controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/play_icon.png"
                                controls:ButtonAssist.ImageHeight="80"
                                controls:ButtonAssist.ImageWidth="80"
                                Click="btnPlayVideo_Click" />
                            <TextBlock
                                x:Name="tbNoData"
                                HorizontalAlignment="Center"
                                Text="{x:Static lang:Resources.NoVideo}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnable}" Value="False">
                            <Setter TargetName="btnPlay" Property="Background" Value="{DynamicResource Transparent}" />
                            <Setter TargetName="btnPlay" Property="BorderThickness" Value="0" />
                            <Setter TargetName="btnPlay" Property="controls:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/no_data_icon.png" />
                            <Setter TargetName="btnPlay" Property="Height" Value="80" />
                            <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.Resources>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
