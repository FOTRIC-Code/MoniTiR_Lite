<UserControl
    x:Class="Firefly.Client.AlarmStatusBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="60"
    d:DesignWidth="800"
    IsVisibleChanged="UserControl_IsVisibleChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="NotifyWarringStoryboard" Completed="Storyboard_Completed">
            <ObjectAnimationUsingKeyFrames
                BeginTime="0:0:0"
                RepeatBehavior="4x"
                Storyboard.TargetName="imgWarrning"
                Storyboard.TargetProperty="(Image.Source)">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.7">
                    <DiscreteObjectKeyFrame.Value>
                        <BitmapImage UriSource="/MoniTiRLite;component/Resources/warrning_on_icon.png" />
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
                <DiscreteObjectKeyFrame KeyTime="0:0:1.4">
                    <DiscreteObjectKeyFrame.Value>
                        <BitmapImage UriSource="/MoniTiRLite;component/Resources/warrning_off_icon.png" />
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <Border
        MinHeight="45"
        Margin="0"
        Padding="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Statusbar}"
        BorderBrush="{StaticResource BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel VerticalAlignment="Center">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Height="28"
                        Margin="0,0,10,0"
                        Click="btnConfirm_Click"
                        Content="{x:Static lang:Resources.Confirm}"
                        IsEnabled="{Binding SelectedAlarm.IsConfirmed, Converter={StaticResource ReverseBooleanConverter}, FallbackValue=False, TargetNullValue=False}"
                        Style="{StaticResource IRtek.Styles.Button.Classic}"
                        Visibility="{Binding AlarmBarVisibility, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Width="36"
                        Height="36"
                        controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/alarm_center_icon.png"
                        controls:ButtonAssist.ImageHeight="22.5"
                        controls:ButtonAssist.ImageWidth="22.5"
                        Click="IrcbMax_OnClick" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Width="36"
                        Height="36"
                        controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_icon.png"
                        controls:ButtonAssist.ImageHeight="18"
                        controls:ButtonAssist.ImageWidth="18"
                        Click="btnExpand_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AlarmBarVisibility}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" CenterX="18" CenterY="18" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AlarmBarVisibility}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="-180" CenterX="18" CenterY="18" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Border Width="40" Height="45">
                        <Image
                            x:Name="imgWarrning"
                            Width="22.5"
                            Height="22.5"
                            Source="/MoniTiRLite;component/Resources/warrning_off_icon.png" />
                    </Border>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Width="36"
                        Height="36"
                        controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/clean_icon.png"
                        controls:ButtonAssist.ImageHeight="22.5"
                        controls:ButtonAssist.ImageWidth="22.5"
                        Click="btnClean_Click" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Width="36"
                        Height="36"
                        controls:ButtonAssist.ImageHeight="22.5"
                        controls:ButtonAssist.ImageWidth="22.5"
                        Click="btnSound_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnableSound}" Value="True">
                                        <Setter Property="controls:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_open_icon.png" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EnableSound}" Value="False">
                                        <Setter Property="controls:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_close_icon.png" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    TextAlignment="Left"
                    TextTrimming="WordEllipsis"
                    TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource IRtek.Styles.TextBlock.Classic}" TargetType="{x:Type TextBlock}">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip DataContext="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=PlacementTarget}">
                                        <TextBlock
                                            MaxWidth="600"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewestAlarmItem.IsConfirmed, FallbackValue=True, TargetNullValue=True}" Value="False">
                                    <Setter Property="Text" Value="{Binding NewestAlarmItem.Description}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <DataGrid
                Grid.Row="1"
                Height="160"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedAlarm}"
                Visibility="{Binding AlarmBarVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding DeviceName}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmDevice}" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding ChannelName}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.Channel}" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding AlarmRegion}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmRegion}" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding AlarmType}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmType}" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding AlarmLevel}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmLevel}" />
                    <DataGridTextColumn
                        Width="580"
                        Binding="{Binding Description}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmDescription}" />
                    <DataGridTemplateColumn
                        Width="100"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.ConfirmState}"
                        SortMemberPath="IsConfirmed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="border"
                                    Width="58"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="tbAlarmStatus"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource SmallFontSize}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Success}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.Confirmed}" />
                                        <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Success}" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConfirmed}" Value="False">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Danger}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.NoConfirm}" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                        <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="100"
                        CanUserSort="True"
                        Header="{x:Static lang:Resources.OutputState}"
                        SortMemberPath="IsExported">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="border"
                                    Width="58"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="tbAlarmStatus"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource SmallFontSize}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExported}" Value="True">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Success}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.Exported}" />
                                        <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Success}" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExported}" Value="False">
                                        <Setter TargetName="border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Danger}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                        <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                        <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.NoExport}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="170"
                        Binding="{Binding AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.AlarmTime}" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Note}"
                        FontSize="{DynamicResource SmallFontSize}"
                        Header="{x:Static lang:Resources.Note}" />
                    <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.Playback}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type client:AlarmItemViewModel}">
                                <Button
                                    Margin="{DynamicResource LeftMargin}"
                                    HorizontalAlignment="Left"
                                    controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/play_icon.png"
                                    Click="btnRecord_Click"
                                    IsEnabled="{Binding HasRecordVideos}"
                                    Style="{DynamicResource IRtek.Styles.Button.Classic}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
