<Window
    x:Class="Firefly.Client.AlarmTipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="AlarmTipWindow"
    Width="840"
    Height="700"
    d:DataContext="{d:DesignInstance Type={x:Type local:AlarmTipViewModel},
                                     IsDesignTimeCreatable=False}"
    Loaded="root_Loaded"
    Style="{StaticResource DialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0,0,0,0" />
        </Style>

        <ItemsPanelTemplate x:Key="PART_lbItemsPanelTemplate">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PART_LiveVideoDataTemplate" DataType="{x:Type local:VideoInfoViewModel}">
            <Grid Margin="{DynamicResource NormalMargin}">
                <control:RTSPClientControl
                    Width="396"
                    Height="297"
                    Margin="{DynamicResource NormalMargin}"
                    HorizontalAlignment="Center"
                    IsPaused="{Binding IsPaused}"
                    MouseDoubleClick="rtspClientControl_MouserDoubleClick"
                    RTSPUrl="{Binding MainStreamURL}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PART_videoDataTemplate" DataType="{x:Type local:VideoInfoViewModel}">
            <Grid Margin="{DynamicResource NormalMargin}">
                <control:RTSPClientControl
                    Width="396"
                    Height="297"
                    Margin="{DynamicResource NormalMargin}"
                    HorizontalAlignment="Center"
                    IsPaused="{Binding IsPaused}"
                    MouseDoubleClick="rtspClientControl_MouserDoubleClick"
                    RTSPUrl="{Binding MainStreamURL}" />
                <Button
                    Width="396"
                    Height="297"
                    Margin="{DynamicResource NormalMargin}"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                    BorderThickness="0"
                    Click="btnPaly_Click">
                    <Button.Content>
                        <controls:SymbolIcon FontSize="48" Symbol="PlayCircle48" />
                    </Button.Content>
                    <Button.Style>
                        <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PART_tabItemTemplate">
            <Grid>
                <TextBlock Text="{Binding .}" />
            </Grid>
        </DataTemplate>

        <Style BasedOn="{StaticResource IRtek.Styles.TabControl.Classic}" TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid
                            x:Name="templateRoot"
                            ClipToBounds="True"
                            KeyboardNavigation.TabNavigation="Local"
                            SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="columnDefinition0" />
                                <ColumnDefinition x:Name="columnDefinition1" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="rowDefinition0" Height="Auto" />
                                <RowDefinition x:Name="rowDefinition1" Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel
                                x:Name="headerPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                MinWidth="{TemplateBinding controls:TabItemAssist.MinWidth}"
                                IsItemsHost="true"
                                KeyboardNavigation.TabIndex="1"
                                ScrollViewer.CanContentScroll="True" />
                            <Border
                                x:Name="contentPanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    ContentSource="SelectedContent"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style BasedOn="{StaticResource IRtek.Styles.TabItem.Classic}" TargetType="{x:Type TabItem}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                ContentSource="Header"
                                Focusable="False"
                                RecognizesAccessKey="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                ToolTip="{TemplateBinding Header}" />
                            <Border
                                x:Name="borderChecked"
                                Width="34"
                                Height="2"
                                Margin="{DynamicResource BottomMargin}"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource IRtek.Brushes.MenuItem.Background.Checked}"
                                Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="borderChecked" Property="Visibility" Value="Visible" />
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:IRtekWindowHeader
            x:Name="PART_Title"
            Title="{x:Static lang:Resources.AlarmMessage}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />

        <ScrollViewer
            Grid.Row="1"
            Height="620"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource LargeMargin}">
                <DockPanel Margin="{DynamicResource NormalMargin}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ViewModel.AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock>
                            <controls:SymbolIcon Margin="{DynamicResource RightMargin}" Symbol="Accessibility20" />
                            <Run Text="{Binding ViewModel.DeviceName}" />
                            <Run Text=" (" />
                            <Run Text="{Binding ViewModel.AlarmType}" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Margin="{DynamicResource NormalMargin}" TextWrapping="Wrap">
                    <controls:SymbolIcon Margin="{DynamicResource RightMargin}" Symbol="Accessibility20" />
                    <Run Text="{Binding ViewModel.AlarmDesc}" />
                </TextBlock>
                <TabControl Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}" SelectionChanged="tcAlarmTip_SelectionChanged">
                    <TabItem Header="{x:Static lang:Resources.CoverImage}">
                        <ListBox
                            Margin="{DynamicResource BottomMargin}"
                            Background="Transparent"
                            ItemsPanel="{StaticResource PART_lbItemsPanelTemplate}"
                            ItemsSource="{Binding ViewModel.ImageURLs}">
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type local:PlaceHolderViewModel}">
                                    <Border Margin="{DynamicResource NormalMargin}" BorderThickness="0">
                                        <Grid Width="396" Height="297">
                                            <control:IRtekImage
                                                x:Name="imgPicture"
                                                Width="396"
                                                Height="297"
                                                Margin="{DynamicResource NormalMargin}"
                                                AnalyzIRClick="btnAnalyzIR_Click"
                                                IsEnabled="{Binding IsEnable}"
                                                Source="{Binding Url}"
                                                SupportAnalyzIR="{Binding IsIR}" />

                                            <StackPanel
                                                x:Name="spNoData"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                                <Image
                                                    x:Name="imgNoData"
                                                    Width="80"
                                                    Height="80"
                                                    Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                                                <TextBlock
                                                    x:Name="tbNoData"
                                                    HorizontalAlignment="Center"
                                                    Text="{x:Static lang:Resources.NoPicture}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                            <Setter TargetName="spNoData" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="imgPicture" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="{x:Static lang:Resources.AlarmVideo}">
                        <ListBox
                            Grid.Row="3"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Margin="{DynamicResource BottomMargin}"
                            Background="Transparent"
                            ItemTemplate="{StaticResource PART_videoDataTemplate}"
                            ItemsPanel="{StaticResource PART_lbItemsPanelTemplate}"
                            ItemsSource="{Binding ViewModel.PlaybackVideoInfoVMs}" />
                    </TabItem>
                    <TabItem Header="{x:Static lang:Resources.Review}">
                        <Grid>
                            <ListBox
                                Grid.Row="3"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                Margin="{DynamicResource BottomMargin}"
                                Background="Transparent"
                                ItemTemplate="{StaticResource PART_videoDataTemplate}"
                                ItemsPanel="{StaticResource PART_lbItemsPanelTemplate}"
                                ItemsSource="{Binding ViewModel.LiveVideoInfoVMs}" />
                            <ComboBox
                                Width="129"
                                Margin="0,-40,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                DisplayMemberPath="Item2"
                                ItemsSource="{Binding ViewModel.PresetList}"
                                SelectedIndex="0"
                                SelectionChanged="cbPreset_SelectionChanged" />
                        </Grid>
                    </TabItem>
                </TabControl>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <Grid Margin="{DynamicResource NormalMargin}">
                    <Grid Margin="{DynamicResource NormalMargin}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock>
                            <Run Text="{x:Static lang:Resources.Note}" />
                            <Run Text=":" />
                        </TextBlock>
                        <TextBox
                            Grid.Row="1"
                            Height="88"
                            Text="{Binding ViewModel.Note}" />
                    </Grid>
                    <StackPanel
                        Margin="0,-10,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="btnTriggerAlarm_Click"
                            Content="{x:Static lang:Resources.ManuallyTriggerAlarm}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <Button
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="btnClearAlarm_Click"
                            Content="{x:Static lang:Resources.ManuallyClearAlarm}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button Click="btnCancel_Click" Content="{x:Static lang:Resources.Cancel}" />
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <Button
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.OK}"
                IsDefault="True" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="{StaticResource ControlDarkBrush}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsVideoFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <control:RTSPClientControl
                x:Name="PART_videoFullScreen"
                Width="880"
                Height="660"
                Margin="{DynamicResource LargeMargin}"
                Background="{StaticResource ControlDarkBrush}"
                MouseDoubleClick="ccRestore_MouserDoubleClick"
                RTSPUrl="{Binding ViewModel.FullScreenURL, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>