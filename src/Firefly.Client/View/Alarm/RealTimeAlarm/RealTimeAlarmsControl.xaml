<TabItem
    x:Class="Firefly.Client.RealTimeAlarmsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:common="clr-namespace:Amur.Common;assembly=Amur.Common"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon AlarmCenter}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.RealTimeAlarms}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    Unloaded="RealTimeAlarmsControl_OnUnloaded"
    mc:Ignorable="d">
    <TabItem.Resources>
        <SolidColorBrush x:Key="ConfirmedBrush" Color="#107c10" />
    </TabItem.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="32" />
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="350" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailViewVisibility}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="{DynamicResource BottomMargin}"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="{DynamicResource LargeMargin}" Text="{x:Static lang:Resources.AlarmLevel}" />
                <ItemsControl
                    Height="27"
                    Margin="{DynamicResource LargeMargin}"
                    BorderThickness="0"
                    ItemsSource="{Binding Filters}">
                    <ItemsControl.Style>
                        <Style BasedOn="{StaticResource {x:Type ItemsControl}}" TargetType="{x:Type ItemsControl}" />
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type client:AlarmFilterViewModel}">
                            <Grid
                                Margin="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <CheckBox
                                    x:Name="cbFilter"
                                    Content="{Binding Filter}"
                                    FontSize="{DynamicResource NormalFontSize}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource IRtek.Styles.CheckBox.Classic}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="">
                                    <Setter TargetName="cbFilter" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <CheckBox Click="btnNeedPopup_Click" IsChecked="{Binding NeedPopup, Mode=OneWay}">
                        <CheckBox.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.CheckBox.Classic}" TargetType="{x:Type CheckBox}">
                                <Setter Property="Content" Value="{x:Static lang:Resources.OpenAlarmTip}" />
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button MinWidth="120" Click="btnSound_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnableSound}" Value="True">
                                        <Setter Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_open_icon.png" />
                                        <Setter Property="Content" Value="{x:Static lang:Resources.CloseSound}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EnableSound}" Value="False">
                                        <Setter Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_close_icon.png" />
                                        <Setter Property="Content" Value="{x:Static lang:Resources.OpenSound}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button MinWidth="120" Click="btnSpeech_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnableSpeech}" Value="True">
                                        <Setter Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_open_icon.png" />
                                        <Setter Property="Content" Value="{x:Static lang:Resources.CloseSpeech}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EnableSpeech}" Value="False">
                                        <Setter Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/sound_close_icon.png" />
                                        <Setter Property="Content" Value="{x:Static lang:Resources.OpenSpeech}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBox
                        Width="200"
                        Height="28"
                        amur:TextBoxAssist.ShowCommandButton="False"
                        amur:TextBoxAssist.Watermark="{x:Static lang:Resources.Search}"
                        Style="{StaticResource IRtek.Styles.TextBox.Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/clean_icon.png"
                        Click="btnClean_Click"
                        Content="{x:Static lang:Resources.Clean}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataGrid
            x:Name="dgAlarm"
            Grid.Row="1"
            Margin="{DynamicResource BottomMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            amur:DataGridAssist.AutoRowNumber="True"
            CanUserSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedAlarm}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding DeviceName}"
                    Header="{x:Static lang:Resources.AlarmDevice}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding ChannelName}"
                    Header="{x:Static lang:Resources.Channel}" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding AlarmRegion}"
                    Header="{x:Static lang:Resources.AlarmRegion}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding AlarmType}"
                    Header="{x:Static lang:Resources.AlarmType}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding AlarmLevel}"
                    Header="{x:Static lang:Resources.AlarmLevel}" />
                <DataGridTextColumn
                    Width="350"
                    Binding="{Binding Description}"
                    Header="{x:Static lang:Resources.AlarmDescription}" />
                <DataGridTemplateColumn
                    Width="100"
                    CanUserSort="True"
                    Header="{x:Static lang:Resources.ConfirmState}"
                    SortMemberPath="IsConfirmed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="border"
                                MinWidth="58"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    x:Name="tbAlarmStatus"
                                    Margin="{DynamicResource NormalMargin}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource SmallFontSize}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Success}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.Confirmed}" />
                                    <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Success}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConfirmed}" Value="False">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Danger}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.NoConfirm}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                    <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    x:Name="AlarmOutputColum"
                    Width="100"
                    CanUserSort="True"
                    Header="{x:Static lang:Resources.OutputState}"
                    SortMemberPath="IsExported">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="border"
                                MinWidth="58"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    x:Name="tbAlarmStatus"
                                    Margin="{DynamicResource NormalMargin}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource SmallFontSize}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExported}" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Success}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.Exported}" />
                                    <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Success}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExported}" Value="False">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.18" Color="{DynamicResource IRtek.Colors.Danger}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="tbAlarmStatus" Property="Text" Value="{x:Static lang:Resources.NoExport}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                    <Setter TargetName="tbAlarmStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding AlarmTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                    Header="{x:Static lang:Resources.AlarmTime}" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Note}"
                    Header="{x:Static lang:Resources.Note}" />
                <DataGridTemplateColumn
                    Width="100"
                    Header="{x:Static lang:Resources.Playback}"
                    SortMemberPath="HasRecordVideos">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type client:VideoViewModel}">
                            <Grid>
                                <amur:Button
                                    Click="btnRecord_Click"
                                    Icon="{amur:SymbolIcon PlayCircle20}"
                                    IsEnabled="{Binding HasRecordVideos}" />
                                <amur:Button
                                    x:Name="btnOff"
                                    Icon="{amur:SymbolIcon Line20}"
                                    IsEnabled="{Binding HasRecordVideos}"
                                    Visibility="Collapsed">
                                    <amur:Button.RenderTransform>
                                        <RotateTransform Angle="90" CenterX="15" CenterY="13.8" />
                                    </amur:Button.RenderTransform>
                                </amur:Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasRecordVideos}" Value="False">
                                    <Setter TargetName="btnOff" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border
            Grid.Row="2"
            Height="32"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.SelectMenu}">
            <Grid>
                <TextBlock Margin="{DynamicResource LeftMargin}" Text="{x:Static lang:Resources.EventDetails}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Height="28"
                        Margin="{StaticResource RightMargin}"
                        HorizontalAlignment="Right"
                        Click="btnConfirm_Click"
                        Content="{x:Static lang:Resources.Confirm}"
                        IsEnabled="{Binding SelectedAlarm.IsConfirmed, Converter={StaticResource ReverseBooleanConverter}, FallbackValue=False, TargetNullValue=False}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Width="36"
                        Height="28"
                        Margin="{DynamicResource RightMargin}"
                        amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_icon.png"
                        amur:ButtonAssist.ImageHeight="18"
                        amur:ButtonAssist.ImageWidth="18"
                        Click="btnExpand_Click">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailViewVisibility}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" CenterX="18" CenterY="14" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DetailViewVisibility}" Value="False">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="-180" CenterX="18" CenterY="14" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer
            x:Name="svEventDetail"
            Grid.Row="3"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Content}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock
                            Height="30"
                            Margin="{DynamicResource LeftMargin}"
                            HorizontalAlignment="Left"
                            Text="{x:Static lang:Resources.LivePreview}" />
                        <CheckBox
                            Margin="{DynamicResource RightMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{x:Static lang:Resources.AutoPlay}"
                            IsChecked="{Binding AutoPlayLiveVideo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Border BorderThickness="0" DockPanel.Dock="Bottom">
                        <ItemsControl ItemsSource="{Binding SelectedAlarm.LiveVideoViewModels}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type client:VideoViewModel}">
                                    <control:RTSPClientControl
                                        Width="400"
                                        Height="300"
                                        Margin="{DynamicResource NormalMargin}"
                                        IsPaused="{Binding IsPaused}"
                                        RTSPUrl="{Binding RTSPUrl}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type client:PlaceHolderViewModel}">
                                    <Border
                                        x:Name="border"
                                        Width="400"
                                        Height="300"
                                        BorderThickness="0">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <Button
                                                x:Name="btnPlay"
                                                Width="400"
                                                Height="300"
                                                amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/play_icon.png"
                                                amur:ButtonAssist.ImageHeight="80"
                                                amur:ButtonAssist.ImageWidth="80"
                                                Click="btnPlayLiveVideo_Click" />
                                            <TextBlock
                                                x:Name="tbNoData"
                                                HorizontalAlignment="Center"
                                                Text="{x:Static lang:Resources.NoVideo}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                            <Setter TargetName="btnPlay" Property="Background" Value="{DynamicResource Transparent}" />
                                            <Setter TargetName="btnPlay" Property="BorderThickness" Value="0" />
                                            <Setter TargetName="btnPlay" Property="amur:ButtonAssist.Image" Value="/MoniTiRLite;component/Resources/no_data_icon.png" />
                                            <Setter TargetName="btnPlay" Property="Width" Value="80" />
                                            <Setter TargetName="btnPlay" Property="Height" Value="80" />
                                            <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </DockPanel>
                <Separator
                    Grid.Column="1"
                    Width="2"
                    Margin="{DynamicResource TopBottomMargin}" />
                <DockPanel Grid.Column="2">
                    <TextBlock
                        Height="30"
                        Margin="{DynamicResource LeftMargin}"
                        DockPanel.Dock="Top"
                        Text="{x:Static lang:Resources.AlarmPicture}" />
                    <Border BorderThickness="0" DockPanel.Dock="Bottom">
                        <ItemsControl VerticalAlignment="Stretch" ItemsSource="{Binding SelectedAlarm.AlarmPictureList, FallbackValue={x:Null}, TargetNullValue={x:Null}}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type client:PlaceHolderViewModel}">
                                    <Border
                                        Width="408"
                                        Height="308"
                                        Margin="{DynamicResource NormalMargin}"
                                        BorderThickness="0">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <control:IRtekImage
                                                x:Name="imgPicture"
                                                Width="400"
                                                Height="300"
                                                Margin="{DynamicResource NormalMargin}"
                                                AnalyzIRClick="btnAnalyzIR_Click"
                                                IsEnabled="{Binding IsEnable}"
                                                Source="{Binding Url}"
                                                SupportAnalyzIR="{Binding IsIR}" />
                                            <TextBlock
                                                x:Name="tbNoData"
                                                HorizontalAlignment="Center"
                                                Text="{x:Static lang:Resources.NoPicture}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                            <Setter TargetName="imgPicture" Property="Source" Value="/MoniTiRLite;component/Resources/no_data_icon.png" />
                                            <Setter TargetName="imgPicture" Property="Width" Value="80" />
                                            <Setter TargetName="imgPicture" Property="Height" Value="80" />
                                            <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</TabItem>
