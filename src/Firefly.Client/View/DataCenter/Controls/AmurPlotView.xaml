<UserControl
    x:Class="Firefly.Client.AmurPlotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyWpf="http://oxyplot.org/wpf"
    xmlns:oxyshared="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:ChartDoubleToDateTimeConverter x:Key="ChartDoubleToDateTimeConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
            <ListBox
                x:Name="lbLegend"
                Margin="{DynamicResource RightMargin}"
                HorizontalAlignment="Right"
                SelectionChanged="ListBox_SelectionChanged"
                SelectionMode="Multiple">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type client:PlotLegendViewModel}">
                        <Border Margin="{DynamicResource NormalMargin}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" />
                                <Rectangle Height="2" Fill="{Binding Foreground}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <oxyWpf:PlotView
            Grid.Row="1"
            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
            Model="{Binding RelativeSource={RelativeSource AncestorType={x:Type client:AmurPlotView}}, Path=CanvasModel}">
            <oxyWpf:PlotView.DefaultTrackerTemplate>
                <ControlTemplate>
                    <oxyshared:TrackerControl
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        HorizontalLineVisibility="Collapsed"
                        LineExtents="{Binding PlotModel.PlotArea}"
                        Position="{Binding Position}">
                        <oxyshared:TrackerControl.Content>
                            <StackPanel
                                Canvas.Left="{Binding Position.X}"
                                Canvas.Top="{Binding Position.Y}"
                                Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Series.Title}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.Time}" />
                                    <TextBlock FontWeight="Bold" Text=":" />
                                    <TextBlock Text="{Binding DataPoint.X, Converter={StaticResource ChartDoubleToDateTimeConverter}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.DataValue}" />
                                    <TextBlock FontWeight="Bold" Text=":" />
                                    <TextBlock Text="{Binding DataPoint.Y, StringFormat={}{0:F1}}" />
                                </StackPanel>
                            </StackPanel>
                        </oxyshared:TrackerControl.Content>
                    </oxyshared:TrackerControl>
                </ControlTemplate>
            </oxyWpf:PlotView.DefaultTrackerTemplate>
        </oxyWpf:PlotView>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <amur:Button
                Width="30"
                Height="30"
                Click="btnHorizontalShrinkage_Click">
                <amur:Button.Icon>
                    <amur:FontIcon
                        FontFamily="{DynamicResource FluentSystemIcons}"
                        FontSize="20"
                        Glyph="&#xF010E;" />
                </amur:Button.Icon>
                <amur:Button.RenderTransform>
                    <RotateTransform Angle="90" CenterX="15" CenterY="15" />
                </amur:Button.RenderTransform>
            </amur:Button>
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <amur:Button
                Width="30"
                Height="30"
                Click="btnVerticalShrinkage_Click">
                <amur:Button.Icon>
                    <amur:FontIcon
                        FontFamily="{DynamicResource FluentSystemIcons}"
                        FontSize="20"
                        Glyph="&#xF010E;" />
                </amur:Button.Icon>
            </amur:Button>
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <amur:Button
                Width="30"
                Height="30"
                Click="btnAdaptive_Click">
                <amur:Button.Icon>
                    <amur:SymbolIcon Symbol="PageFit20" />
                </amur:Button.Icon>
            </amur:Button>
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <amur:Button
                Width="30"
                Height="30"
                Click="btnHorizontalMagnification_Click">
                <amur:Button.Icon>
                    <amur:SymbolIcon Symbol="ArrowAutofitWidth20" />
                </amur:Button.Icon>
            </amur:Button>
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <amur:Button
                Width="30"
                Height="30"
                Click="btnVerticalMagnification_Click">
                <amur:Button.Icon>
                    <amur:SymbolIcon Symbol="ArrowAutofitHeight20" />
                </amur:Button.Icon>
            </amur:Button>
        </StackPanel>
    </Grid>
</UserControl>
