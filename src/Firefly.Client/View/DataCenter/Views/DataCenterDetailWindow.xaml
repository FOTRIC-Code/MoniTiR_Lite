<Window
    x:Class="Firefly.Client.DataCenterDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyWpf="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    xmlns:oxyshared="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
    x:Name="root"
    Title="DataCenterDetailWindow"
    Width="1200"
    Height="880"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <local:ChartDoubleToDateTimeConverter x:Key="ChartDoubleToDateTimeConverter" />
        <Style x:Key="DynamicColumnNameHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource IRtek.Brushes.DataGridColumnHeader.Foreground}"
                                Text="{Binding .}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DynamicColumnDataHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="{DynamicResource NormalMargin}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource IRtek.Brushes.DataGridColumnHeader.Foreground}"
                                Text="{Binding Header}" />
                            <ItemsControl
                                Grid.Row="1"
                                HorizontalContentAlignment="Center"
                                ItemsSource="{Binding SubHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding SubHeaders.Count}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="{DynamicResource NormalMargin}"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource IRtek.Brushes.DataGridColumnHeader.Foreground}"
                                            Text="{Binding .}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <amur:IRtekWindowHeader
            Title="{x:Static lang:Resources.RecordDetail}"
            Grid.Row="0"
            Height="40"
            DockPanel.Dock="Top"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel>
            <Grid
                Margin="{DynamicResource TopMargin}"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding FullRegionName}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <amur:Button
                        Margin="{DynamicResource RightMargin}"
                        BorderThickness="1"
                        Click="btnExport_Click"
                        Content="{x:Static lang:Resources.Export}"
                        IsEnabled="{Binding HasRecord}">
                        <amur:Button.Icon>
                            <amur:SymbolIcon Symbol="ArrowExportUp20" />
                        </amur:Button.Icon>
                    </amur:Button>
                    <amur:Button
                        Margin="{DynamicResource RightMargin}"
                        HorizontalAlignment="Right"
                        BorderThickness="1"
                        Click="btnExportAll_Click"
                        Content="{x:Static lang:Resources.ExportAll}"
                        IsEnabled="{Binding HasRecord}">
                        <amur:Button.Icon>
                            <amur:SymbolIcon Symbol="ArrowExportUp20" />
                        </amur:Button.Icon>
                    </amur:Button>
                </StackPanel>
            </Grid>
            <Grid
                x:Name="gChartPanel"
                Height="300"
                DockPanel.Dock="Bottom">
                <local:AmurPlotView x:Name="amurPlotView" />
                <oxyWpf:PlotView
                    Grid.Row="1"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                    Model="{Binding CanvasModel}"
                    Visibility="Collapsed">
                    <oxyWpf:PlotView.DefaultTrackerTemplate>
                        <ControlTemplate>
                            <oxyshared:TrackerControl
                                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                                HorizontalLineVisibility="Collapsed"
                                LineExtents="{Binding PlotModel.PlotArea}"
                                Position="{Binding Position}">
                                <oxyshared:TrackerControl.Content>
                                    <StackPanel
                                        Canvas.Left="{Binding Position.X}"
                                        Canvas.Top="{Binding Position.Y}"
                                        Margin="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Series.SeriesGroupName}" />
                                            <TextBlock FontWeight="Bold" Text="-" />
                                            <TextBlock Text="{Binding Series.Title}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.Time}" />
                                            <TextBlock FontWeight="Bold" Text=":" />
                                            <TextBlock Text="{Binding DataPoint.X, Converter={StaticResource ChartDoubleToDateTimeConverter}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.DataValue}" />
                                            <TextBlock FontWeight="Bold" Text=":" />
                                            <TextBlock Text="{Binding DataPoint.Y, StringFormat={}{0:F1}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </oxyshared:TrackerControl.Content>
                            </oxyshared:TrackerControl>
                        </ControlTemplate>
                    </oxyWpf:PlotView.DefaultTrackerTemplate>
                </oxyWpf:PlotView>
            </Grid>
            <Grid Margin="{DynamicResource BottomMargin}" DockPanel.Dock="Bottom">
                <control:Pagination x:Name="pPagination" PageChanged="Pagination_PageChanged" />
                <ToggleButton
                    x:Name="tbtnExpend"
                    Height="34"
                    Margin="{DynamicResource LeftMargin}"
                    HorizontalAlignment="Left">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource IRtek.Styles.ToggleButton.Classic}" TargetType="{x:Type ToggleButton}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource IRtek.Brushes.Button.Border}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <StackPanel Margin="{DynamicResource LargeMargin}" Orientation="Horizontal">
                                                <amur:SymbolIcon x:Name="siIcon" Symbol="ChevronDown20" />
                                                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                                <TextBlock x:Name="tbName" Text="{x:Static lang:Resources.Collapse}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="tbName" Property="Text" Value="{x:Static lang:Resources.Collapse}" />
                                                <Setter TargetName="siIcon" Property="Symbol" Value="ChevronDown20" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="tbName" Property="Text" Value="{x:Static lang:Resources.Expansion}" />
                                                <Setter TargetName="siIcon" Property="Symbol" Value="ChevronUp20" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                    <ToggleButton.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="gChartPanel"
                                        Storyboard.TargetProperty="Height"
                                        To="0"
                                        Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="gChartPanel"
                                        Storyboard.TargetProperty="Height"
                                        To="350"
                                        Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ToggleButton.Triggers>
                </ToggleButton>
            </Grid>
            <Grid Margin="{DynamicResource LargeMargin}" DockPanel.Dock="Top">
                <local:DynamicDataGrid
                    x:Name="dgData"
                    amur:DataGridAssist.AutoRowNumber="True"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataList}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectdData}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}"
                            Header="{x:Static lang:Resources.Order}" />
                        <DataGridTextColumn
                            Width="210"
                            Binding="{Binding HappenTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Header="{x:Static lang:Resources.HappenTime}" />
                        <DataGridTemplateColumn
                            Width="100"
                            CanUserResize="False"
                            Header="{x:Static lang:Resources.Picture}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Left"
                                        amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/config_icon.png"
                                        Click="btnShowImage_Click"
                                        IsEnabled="{Binding HasImages}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </local:DynamicDataGrid>
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasRecord, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                    <Image
                        Width="80"
                        Height="80"
                        Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                    <TextBlock Text="{x:Static lang:Resources.NoRecord}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
