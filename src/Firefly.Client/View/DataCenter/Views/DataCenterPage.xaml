<Page
    x:Class="Firefly.Client.DataCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="850"
    d:DesignWidth="1800"
    Foreground="{StaticResource IRtek.Brushes.ThemeForeground}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <DockPanel Margin="{DynamicResource BottomMargin}">
        <Border
            Width="375"
            Padding="{DynamicResource HugeMargin}"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Menu}"
            DockPanel.Dock="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Resources.StartTime}" />
                    <Rectangle Margin="{StaticResource NormalMargin}" />
                    <control:EditableDateTime Time="{Binding BeginTime}" />

                    <Rectangle Margin="{StaticResource LargeMargin}" />
                    <TextBlock Text="{x:Static lang:Resources.EndTime}" />
                    <Rectangle Margin="{StaticResource NormalMargin}" />
                    <control:EditableDateTime Time="{Binding EndTime}" />

                    <Rectangle Margin="{StaticResource HugeMargin}" />
                    <TextBlock Text="{x:Static lang:Resources.QueryType}" />
                    <Rectangle Margin="{StaticResource LeftTopMargin}" />
                    <Border BorderBrush="White" BorderThickness="0">
                        <RadioButton
                            MinWidth="100"
                            Checked="rbQueryDevice_OnChecked"
                            Content="{x:Static lang:Resources.Device}"
                            GroupName="QueryType"
                            IsChecked="True" />
                    </Border>
                    <Rectangle Margin="{StaticResource NormalMargin}" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <TreeView
                        x:Name="TreeView"
                        FontSize="{DynamicResource NormalFontSize}"
                        ItemsSource="{Binding SelectionTree.Children}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type client:TreeItem}" ItemsSource="{Binding Children}">
                                <StackPanel
                                    x:Name="spFolderItem"
                                    DataContext="{Binding}"
                                    Orientation="Horizontal">
                                    <control:SymbolIcon x:Name="icon" Margin="{DynamicResource RightMargin}" />
                                    <CheckBox
                                        IsChecked="{Binding IsChecked}"
                                        IsEnabled="{Binding IsEnabled}"
                                        IsThreeState="{Binding IsNotLeafNode}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static client:ItemType.Station}">
                                        <Setter TargetName="icon" Property="Symbol" Value="Station" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static client:ItemType.Equipment}">
                                        <Setter TargetName="icon" Property="Symbol" Value="Equipment" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static client:ItemType.Device}">
                                        <Setter TargetName="icon" Property="Symbol" Value="Equipment" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource IRtek.Styles.TreeViewItem.Classic}" TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasItem, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                        <Image
                            Width="260"
                            Height="159"
                            Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                        <TextBlock Text="{x:Static lang:Resources.NoRecord}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Button
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Click="btnSearch_Click"
                    Content="{x:Static lang:Resources.Search}" />
            </Grid>
        </Border>
        <Grid DockPanel.Dock="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border
                Height="32"
                Margin="{DynamicResource LeftTopBottomMargin}"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBox
                        Width="200"
                        Height="28"
                        HorizontalAlignment="Right"
                        controls:TextBoxAssist.Watermark="{x:Static lang:Resources.Search}"
                        Style="{StaticResource IRtek.Styles.TextBox.Search}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Height="28"
                        HorizontalAlignment="Left"
                        controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/refresh_icon.png"
                        controls:ButtonAssist.ImageHeight="18"
                        controls:ButtonAssist.ImageWidth="18"
                        Click="btnRefresh_Click"
                        Content="{x:Static lang:Resources.Refresh}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <Button
                        Height="28"
                        controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/export_icon.png"
                        controls:ButtonAssist.ImageHeight="18"
                        controls:ButtonAssist.ImageWidth="18"
                        Click="btnExport_Click"
                        Content="{x:Static lang:Resources.Export}"
                        IsEnabled="{Binding HasRecord}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="1">
                <DataGrid
                    Margin="{DynamicResource LeftMargin}"
                    controls:DataGridAssist.AutoRowNumber="True"
                    FontSize="{StaticResource NormalFontSize}"
                    IsReadOnly="True"
                    ItemsSource="{Binding DeviceDataList}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedDeviceDataRecord}"
                    SelectionMode="Single"
                    Style="{StaticResource IRtek.Styles.DataGrid.Classic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="76"
                            Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}"
                            Header="{x:Static lang:Resources.Order}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding FullRegionName}"
                            Header="{x:Static lang:Resources.GroupName}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding DeviceName}"
                            Header="{x:Static lang:Resources.Device}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding ChannelName}"
                            Header="{x:Static lang:Resources.ChannelName}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding PresetName}"
                            Header="{x:Static lang:Resources.Preset}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding DataCount}"
                            Header="{x:Static lang:Resources.DataRecord}" />
                        <DataGridTextColumn
                            Width="340"
                            Binding="{Binding AlarmStatistics}"
                            Header="{x:Static lang:Resources.AlarmRecord}" />
                        <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.Operation}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="25"
                                            Height="25"
                                            HorizontalAlignment="Left"
                                            controls:ButtonAssist.Image="/MoniTiRLite;component/Resources/config_icon.png"
                                            Click="btnShowChart_Click"
                                            ToolTip="{x:Static lang:Resources.Details}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasRecord, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                    <Image
                        Width="260"
                        Height="159"
                        Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                    <Rectangle Margin="{DynamicResource LargeMargin}" />
                    <TextBlock Text="{x:Static lang:Resources.NoRecord}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Page>
