<Window x:Class="Firefly.Client.DataCenterRecordImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Firefly.Client"
        xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
        xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
        x:Name="root"
        mc:Ignorable="d" Style="{StaticResource ResizableDialogWindow}"
        WindowStartupLocation="CenterOwner"
        Title="DataCenterRecordImageWindow" Height="360" Width="835" MinHeight="360" MinWidth="835">
    <Window.Resources>
        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource ControlLightLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{x:Static lang:Resources.Picture}" ResizeMode="{Binding ResizeMode,ElementName=root}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="lbImage" Grid.Column="0" ItemsSource="{Binding ImageList}" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type local:AlarmImageViewModel}">
                        <Border BorderThickness="{DynamicResource DefaultBorderThickness}" BorderBrush="{DynamicResource BorderBrush}" Margin="{DynamicResource NormalMargin}">
                            <Image Height="90" Source="{Binding Image}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ListBox>
            <Image Grid.Column="1" Source="{Binding ElementName=lbImage,Path=SelectedItem.Image}" />
        </Grid>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasImage, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
            <Image Width="80" Height="80" Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
            <TextBlock Text="{x:Static lang:Resources.NoPicture}" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
