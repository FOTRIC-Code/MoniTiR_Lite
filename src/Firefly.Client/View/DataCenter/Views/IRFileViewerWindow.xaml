<Window
    x:Class="Firefly.Client.IRFileViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="IRFileViewerWindow"
    Width="800"
    Height="450"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{x:Static lang:Resources.Picture}" ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="2" Rows="1">
                    <Button
                        Height="32"
                        Margin="{DynamicResource NormalMargin}"
                        Click="btnPrevGroup_Click"
                        Content="{x:Static lang:Resources.PrevGroup}"
                        IsEnabled="{Binding IsPrevGroupEnabled}" />
                    <Button
                        Height="32"
                        Margin="{DynamicResource NormalMargin}"
                        Click="btnNextGroup_Click"
                        Content="{x:Static lang:Resources.NextGroup}"
                        IsEnabled="{Binding IsNextGroupEnabled}" />
                </UniformGrid>
                <ListBox
                    x:Name="lbImage"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    BorderThickness="0"
                    ItemsSource="{Binding ImageList}"
                    SelectedIndex="0"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionChanged="lbImage_SelectionChanged">
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type local:IRFileViewerItemViewModel}">
                            <Border
                                Margin="{DynamicResource NormalMargin}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="{DynamicResource DefaultBorderThickness}">
                                <Image
                                    Height="120"
                                    MinWidth="160"
                                    Source="{Binding ImageSource}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel HorizontalAlignment="Center" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ListBox>
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Width="1"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource IRtek.Brushes.Highlight}" />
            </Grid>
            <control:DCFileControl
                x:Name="uniFileControl"
                Grid.Column="1"
                Visibility="Hidden" />
            <control:IRtekFileControl
                x:Name="irtekFileControl"
                Grid.Column="1"
                FontSize="20"
                Visibility="Hidden" />
            <control:UNIIRFileControl
                x:Name="uniIRFileControl"
                Grid.Column="1"
                FontSize="20"
                Visibility="Hidden" />

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasImage, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                <Image
                    Width="80"
                    Height="80"
                    Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                <TextBlock
                    Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
                    Text="{x:Static lang:Resources.NoData}"
                    TextAlignment="Center" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasImage, Mode=OneWay, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                <Image
                    Width="80"
                    Height="80"
                    Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                <TextBlock
                    Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
                    Text="{x:Static lang:Resources.NoPicture}"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
