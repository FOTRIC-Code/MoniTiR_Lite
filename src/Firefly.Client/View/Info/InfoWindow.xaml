<Window
    x:Class="Firefly.Client.InfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InfoWindow"
    Width="480"
    Height="270"
    d:DataContext="{d:DesignInstance local:InfoWindow,
                                     IsDesignTimeCreatable=False}"
    Style="{StaticResource ResizableDialogWindow}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amur:IRtekWindowHeader
            Title="{x:Static lang:Resources.BasicInfo}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1">
            <ListBox Margin="{DynamicResource LargeMargin}" ItemsSource="{Binding ViewModel.Infos}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text=" :" />
                            </StackPanel>
                            <Grid Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="rect" Grid.Column="0" />
                                <TextBlock
                                    MaxWidth="410"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Description}" />
                                <amur:Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Click="btnCopyInfo_Click"
                                    Icon="{control:SymbolIcon Copy}"
                                    Tag="{Binding Description}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
