<Window x:Class="Firefly.Client.LivePreviewFullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowStyle="None" Loaded="LivePreviewFullScreenWindow_Loaded"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Title="LivePreviewFullScreenWindow" Height="450" Width="800">
    <Window.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>
    <Grid x:Name="gridParent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
    </Grid>
</Window>
