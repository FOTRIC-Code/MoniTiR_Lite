<Page
    x:Class="Firefly.Client.LivePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    Title="LivePreviewPage"
    d:DataContext="{d:DesignInstance local:LivePreviewPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="LivePreviewPage_Loaded"
    PreviewMouseLeftButtonDown="LivePreviewPage_OnPreviewMouseLeftButtonDown"
    Unloaded="LivePreviewPage_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource IRtek.Brushes.TabItem.Foreground}" />
            <Setter Property="Background" Value="{DynamicResource IRtek.Brushes.TabItem.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.TabItem.Border}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="6,2,6,2" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource NormalFontSize}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <Border
                                x:Name="mainBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1,1,1,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#1443506C" />
                                        <GradientStop Offset="1" Color="#993B4459" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Orientation="Horizontal">
                                <ContentPresenter
                                    x:Name="contentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    ContentSource="Header"
                                    Focusable="False"
                                    RecognizesAccessKey="False"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    ToolTip="{TemplateBinding Header}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                                    <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource IRtek.Brushes.TabItem.Foreground.Disabled}" />
                                <Setter TargetName="mainBorder" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Opacity" Value="0.56" />
                            </MultiDataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="mainBorder" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter TargetName="mainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#146B7999" />
                                            <GradientStop Offset="1" Color="#9967728B" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{DynamicResource IRtek.Brushes.TabItem.Border.MouseOver}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Panel.ZIndex" Value="1" />
                                <Setter TargetName="mainBorder" Property="BorderThickness" Value="1,1,1,0" />
                                <Setter TargetName="mainBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#146B7999" />
                                            <GradientStop Offset="1" Color="#9967728B" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="mainBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="#54617B" />
                                            <GradientStop Offset="1" Color="#2A3246" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="cmCruisePage">
            <MenuItem
                Name="Delete"
                Click="cmCruisePageDelete_Click"
                Header="{x:Static lang:Resources.Delete}" />
        </ContextMenu>
    </Page.Resources>
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel
            x:Name="dpLeftPanel"
            Width="350"
            Margin="{DynamicResource TopBottomMargin}"
            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Menu}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
                <Grid Height="32" Background="{DynamicResource IRtek.Brushes.ThemeBackground.SelectMenu}">
                    <TextBlock
                        Margin="{DynamicResource LeftMargin}"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
                        Text="{x:Static lang:Resources.PTZControl}" />
                    <amur:Button
                        x:Name="btnExpand"
                        Width="30"
                        Height="28"
                        Margin="{DynamicResource RightMargin}"
                        HorizontalAlignment="Right"
                        Click="btnExpand_Click">
                        <amur:Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Icon}" TargetType="{x:Type amur:Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.PTZControlVisibility}" Value="Visible">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <amur:SymbolIcon Symbol="ChevronDown20" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewModel.PTZControlVisibility}" Value="Collapsed">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <amur:SymbolIcon Symbol="ChevronUp20" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </amur:Button.Style>
                    </amur:Button>
                </Grid>
                <StackPanel Orientation="Vertical" Visibility="{Binding ViewModel.PTZControlVisibility}">
                    <UniformGrid
                        Width="200"
                        Columns="4"
                        Visibility="{Binding ViewModel.IsIRCameraPTZLayoutEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            Margin="{DynamicResource LargeMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_down_icon.png"
                            PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.FOCUS_NEAR}"
                            ToolTip="{x:Static lang:Resources.Focus}" />
                        <Button
                            Margin="{DynamicResource LargeMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/auto_focus_icon.png"
                            PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.FOCUS_AUTO}"
                            ToolTip="{x:Static lang:Resources.AutoFocus}" />
                        <Button
                            Margin="{DynamicResource LargeMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_up_icon.png"
                            PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.FOCUS_FAR}"
                            ToolTip="{x:Static lang:Resources.Focus}" />
                        <Button
                            Margin="{DynamicResource LargeMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/wiper_icon.png"
                            Click="btnDoWiper_Click"
                            Tag="{x:Static service:PTZCommand.WIPER}"
                            ToolTip="{x:Static lang:Resources.Wiper}" />
                    </UniformGrid>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                    <Grid IsEnabled="{Binding ViewModel.IsIRCameraPTZLayoutEnable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <control:WheelControl
                            Grid.Column="1"
                            Width="120"
                            Height="120"
                            MouseLeftButtonDown="WheelControl_MouseLeftButtonDown"
                            MouseLeftButtonUp="WheelControl_MouseLeftButtonUp" />
                        <Slider
                            x:Name="sldSpeed"
                            Grid.Column="2"
                            Width="20"
                            Height="160"
                            HorizontalAlignment="Left"
                            Maximum="10"
                            Minimum="1"
                            Orientation="Vertical"
                            Style="{StaticResource VerticalSlider}"
                            Value="5" />
                    </Grid>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                    <UniformGrid
                        Width="200"
                        Columns="3"
                        Visibility="{Binding ViewModel.IsDCCameraPTZLayoutEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            Width="30"
                            Height="28"
                            Margin="{DynamicResource NormalMargin}"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_up_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.FOCUS_FAR}"
                            ToolTip="{x:Static lang:Resources.Focus}" />
                        <Button
                            Width="30"
                            Height="28"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/aperture_up_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.IRIS_OPEN}"
                            ToolTip="{x:Static lang:Resources.Aperture}" />
                        <Button
                            Width="30"
                            Height="28"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/zoom_up_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.ZOOM_IN}"
                            ToolTip="{x:Static lang:Resources.Zoom}" />
                        <Button
                            Width="30"
                            Height="28"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_down_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.FOCUS_NEAR}"
                            ToolTip="{x:Static lang:Resources.Focus}" />
                        <Button
                            Width="30"
                            Height="28"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/aperture_down_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.IRIS_CLOSE}"
                            ToolTip="{x:Static lang:Resources.Aperture}" />
                        <Button
                            Width="30"
                            Height="28"
                            amur:ButtonAssist.Image="/MoniTiRLite;component/Resources/zoom_down_icon.png"
                            PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                            Tag="{x:Static service:PTZCommand.ZOOM_OUT}"
                            ToolTip="{x:Static lang:Resources.Zoom}" />
                    </UniformGrid>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                    <Border
                        Width="350"
                        Height="2"
                        Margin="{DynamicResource LargeMargin}"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource IRtek.Brushes.Intervals.Background}" />
                    <TabControl IsEnabled="{Binding ViewModel.IsIRCameraPTZLayoutEnable}" TabStripPlacement="Top">
                        <TabItem Width="175" Header="{x:Static lang:Resources.Preset}">
                            <ListBox
                                Height="180"
                                BorderThickness="0"
                                ItemsSource="{Binding ViewModel.PresetItems}"
                                SelectedItem="{Binding ViewModel.SelectedPreset}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RealTimePresetItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                MouseLeftButtonDown="btnGotoPreset_Click"
                                                Text="{Binding Name}"
                                                TextTrimming="WordEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Width="175" Header="{x:Static lang:Resources.CruiseRoute}">
                            <ListBox
                                Height="180"
                                BorderThickness="0"
                                ItemsSource="{Binding ViewModel.CruiseItems}"
                                SelectedItem="{Binding ViewModel.SelectedCruise}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RealTimeCruiseItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <amur:SymbolIcon
                                                x:Name="iconCruise"
                                                DockPanel.Dock="Right"
                                                Filled="True"
                                                Foreground="{DynamicResource IRtek.Brushes.Success}"
                                                Symbol="Circle16"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Text="{Binding Name}"
                                                TextTrimming="WordEllipsis"
                                                TextWrapping="NoWrap" />
                                            <amur:Button
                                                x:Name="btnCruise"
                                                Grid.Column="2"
                                                Width="30"
                                                Height="28"
                                                Margin="{DynamicResource NormalMargin}"
                                                HorizontalAlignment="Right"
                                                Click="btnRunCruise_Click"
                                                Icon="{amur:SymbolIcon PlayCircle20}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CruiseStatus}" Value="True">
                                                <Setter TargetName="iconCruise" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="btnCruise" Property="Icon" Value="{amur:SymbolIcon RecordStop20}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </StackPanel>
            <StackPanel
                Margin="0,1,0,0"
                DockPanel.Dock="Bottom"
                Orientation="Vertical">
                <Grid Height="32" Background="{DynamicResource IRtek.Brushes.ThemeBackground.SelectMenu}">
                    <TextBlock
                        Margin="{DynamicResource LeftMargin}"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
                        Text="{x:Static lang:Resources.PlanPolling}" />
                    <amur:Button
                        x:Name="btnExpandCruise"
                        Width="30"
                        Height="28"
                        Margin="{DynamicResource RightMargin}"
                        HorizontalAlignment="Right"
                        Click="btnExpandCruise_Click">
                        <amur:Button.Style>
                            <Style BasedOn="{StaticResource IRtek.Styles.Button.Icon}" TargetType="{x:Type amur:Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.CruiseControlVisibility}" Value="Visible">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <amur:SymbolIcon Symbol="ChevronDown20" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ViewModel.CruiseControlVisibility}" Value="Collapsed">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <amur:SymbolIcon Symbol="ChevronUp20" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </amur:Button.Style>
                    </amur:Button>
                </Grid>
                <StackPanel Orientation="Vertical" Visibility="{Binding ViewModel.CruiseControlVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
                            <amur:Button
                                x:Name="btnBeginAddPolling"
                                Margin="{DynamicResource NormalMargin}"
                                HorizontalAlignment="Right"
                                Click="btnBeginAddPolling_Click"
                                Content="{x:Static lang:Resources.Add}"
                                Icon="{amur:SymbolIcon AddCircle20}"
                                Visibility="{Binding ViewModel.IsAddCruisePlan, Converter={StaticResource ReverseLogicToVisibilityConverter}}" />
                            <StackPanel
                                x:Name="spPolling"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding ViewModel.IsAddCruisePlan, Converter={StaticResource BoolToVisibilityConverter}}">
                                <amur:Button
                                    Margin="{DynamicResource NormalMargin}"
                                    Click="btnCancelAddPolling_Click"
                                    Content="{x:Static lang:Resources.Cancel}"
                                    Icon="{amur:SymbolIcon Dismiss24}" />
                                <amur:Button
                                    Margin="{DynamicResource NormalMargin}"
                                    Background="{DynamicResource IRtek.Brushes.Button.Background.IsDefault}"
                                    Click="btnSavePolling_Click"
                                    Content="{x:Static lang:Resources.Save}"
                                    Icon="{amur:SymbolIcon Checkmark24}" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            Height="300"
                            BorderThickness="0"
                            IsEnabled="{Binding ViewModel.IsAddCruisePlan, Converter={StaticResource ReverseBooleanConverter}}"
                            ItemsSource="{Binding ViewModel.PollingGroups}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PollingGroupViewModel}">
                                    <Grid Margin="{DynamicResource NormalMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                MaxWidth="180"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding Name}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Grid.Column="1" Text="{Binding Second}" />
                                            <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                            <amur:Button
                                                x:Name="btnPolling"
                                                Width="28"
                                                Height="24"
                                                Click="btnPolling_Click">
                                                <amur:Button.Icon>
                                                    <amur:SymbolIcon Symbol="PlayCircle20" />
                                                </amur:Button.Icon>
                                            </amur:Button>
                                            <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                            <amur:Button
                                                x:Name="btnEditPollingGroup"
                                                Width="28"
                                                Height="24"
                                                Click="btnEditPollingGroup_Click">
                                                <amur:Button.Icon>
                                                    <amur:SymbolIcon Symbol="Edit20" />
                                                </amur:Button.Icon>
                                            </amur:Button>
                                            <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                            <amur:Button
                                                x:Name="btnDeletePollingGroup"
                                                Width="28"
                                                Height="24"
                                                Click="btnDeletePollingGroup_Click">
                                                <amur:Button.Icon>
                                                    <amur:SymbolIcon Symbol="Delete20" />
                                                </amur:Button.Icon>
                                            </amur:Button>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter TargetName="btnEditPollingGroup" Property="IsEnabled" Value="False" />
                                            <Setter TargetName="btnDeletePollingGroup" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter TargetName="btnPolling" Property="Icon" Value="{control:SymbolIcon Pause}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LivePreviewPage}}, Path=ViewModel.IsPollingStarted}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="btnPolling" Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LivePreviewPage}}, Path=ViewModel.IsPollingStarted}" Value="True">
                                            <Setter TargetName="btnEditPollingGroup" Property="IsEnabled" Value="False" />
                                            <Setter TargetName="btnDeletePollingGroup" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Height="32" Background="{DynamicResource IRtek.Brushes.ThemeBackground.SelectMenu}">
                    <TextBlock
                        Margin="{DynamicResource LeftMargin}"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
                        Text="{x:Static lang:Resources.Device}" />
                </Grid>
                <TextBox
                    x:Name="tbSearch"
                    Grid.Row="1"
                    Height="36"
                    Margin="0,0,0,1"
                    amur:TextBoxAssist.ButtonCommand="{Binding ViewModel.SearchTextCommand}"
                    amur:TextBoxAssist.ShowClearButton="False"
                    amur:TextBoxAssist.ShowCommandButton="True"
                    amur:TextBoxAssist.ShowIcon="False"
                    amur:TextBoxAssist.Watermark="{x:Static lang:Resources.Search}"
                    Style="{StaticResource IRtek.Styles.TextBox.Search}"
                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Popup
                    Width="{Binding ActualWidth, ElementName=tbSearch}"
                    IsOpen="{Binding ViewModel.IsSearching}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=tbSearch}"
                    StaysOpen="False">
                    <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
                        <ListView
                            Height="260"
                            Margin="{DynamicResource LeftRightBottomMargin}"
                            ItemsSource="{Binding ViewModel.SearchingDisplayItems}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MouseLeftButtonDown="lviSearchResult_MouseLeftButtonDown">
                                        <TextBlock Margin="{DynamicResource LeftTopBottomMargin}" Text="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Popup>
                <TreeView
                    x:Name="tvDevice"
                    Grid.Row="2"
                    BorderThickness="0"
                    ItemsSource="{Binding ViewModel.RootDeviceTreeItem.Children}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:TreeItem}" ItemsSource="{Binding Children}">
                            <DockPanel
                                x:Name="dpChild"
                                DataContext="{Binding}"
                                MouseDown="TreeViewItem_MouseDown">
                                <Image Width="18" DockPanel.Dock="Left">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static local:ItemType.Channel}">
                                                    <Setter Property="Source" Value="/MoniTiRLite;component/Resources/device_selected_icon.png" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static local:ItemType.Device}">
                                                    <Setter Property="Source" Value="/MoniTiRLite;component/Resources/tree_icon.png" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Rectangle Margin="{DynamicResource NormalMargin}" DockPanel.Dock="Left" />
                                <DockPanel DockPanel.Dock="Right">
                                    <amur:SymbolIcon
                                        x:Name="iconStatus"
                                        DockPanel.Dock="Right"
                                        Filled="True"
                                        Foreground="{DynamicResource IRtek.Brushes.Success}"
                                        Symbol="Circle16"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="tbName"
                                        DockPanel.Dock="Left"
                                        Text="{Binding Name}" />
                                </DockPanel>
                            </DockPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter TargetName="iconStatus" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static local:ItemType.Device}">
                                    <Setter TargetName="iconStatus" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource IRtek.Styles.TreeViewItem.Classic}" TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsEnabled" Value="{Binding IsOnline}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </DockPanel>
        <DockPanel
            x:Name="dockVideo"
            Grid.Column="1"
            Margin="{DynamicResource LeftTopBottomMargin}">
            <Grid Height="45" DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource IRtek.Brushes.TabItem.Background}" />

                <Grid Grid.Column="1">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsAddCruisePlan, Converter={StaticResource BoolToVisibilityConverter}}">

                        <ListView
                            x:Name="lvCruisePlanPage"
                            ContextMenu="{StaticResource cmCruisePage}"
                            ItemsSource="{Binding ViewModel.CruisePageList}"
                            SelectedIndex="0">
                            <ListView.Resources>
                                <Style BasedOn="{StaticResource IRtek.Styles.ListViewItem.Classic}" TargetType="{x:Type ListViewItem}">
                                    <Setter Property="MinHeight" Value="43" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="border"
                                        Width="38"
                                        Height="43"
                                        Background="#01000000"
                                        MouseLeftButtonDown="lvCruisePage_MouseLeftButtonDown">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource IRtek.Brushes.ItemsControl.Item.Foreground}"
                                            Text="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Rectangle Margin="{DynamicResource NormalMargin}" />
                        <amur:Button
                            Height="45"
                            Click="btnAddCruisePage_Click"
                            ToolTip="{x:Static lang:Resources.Add}">
                            <amur:Button.Icon>
                                <amur:SymbolIcon Symbol="Add24" />
                            </amur:Button.Icon>
                        </amur:Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsPollingStarted, Converter={StaticResource BoolToVisibilityConverter}}">
                        <amur:Button
                            Width="28"
                            Height="28"
                            Click="btnPrevPollingGroup_Click"
                            ToolTip="{x:Static lang:Resources.PrevGroup}">
                            <amur:Button.Icon>
                                <amur:SymbolIcon Symbol="ChevronLeft20" />
                            </amur:Button.Icon>
                        </amur:Button>
                        <Rectangle Margin="{DynamicResource NormalMargin}" />
                        <TextBlock Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}" Text="{x:Static lang:Resources.InTheCarousel}" />
                        <Rectangle Margin="{DynamicResource NormalMargin}" />
                        <amur:Button
                            Width="30"
                            Height="28"
                            Click="btnNextPollingGroup_Click"
                            ToolTip="{x:Static lang:Resources.NextGroup}">
                            <amur:Button.Icon>
                                <amur:SymbolIcon Symbol="ChevronRight20" />
                            </amur:Button.Icon>
                        </amur:Button>
                    </StackPanel>
                </Grid>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ViewModel.IsAddPollingMode, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                    <amur:Button
                        Width="28"
                        Height="28"
                        Click="btnStopPreview_Click"
                        IsEnabled="{Binding ViewModel.IsPollingStarted, Converter={StaticResource ReverseBooleanConverter}}"
                        ToolTip="{x:Static lang:Resources.StopAllPreview}">
                        <amur:Button.Icon>
                            <amur:SymbolIcon Filled="True" Symbol="Stop20" />
                        </amur:Button.Icon>
                    </amur:Button>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                    <amur:Button
                        x:Name="btnSplitMode"
                        Width="28"
                        Height="28"
                        Click="btnSplitMode_Click"
                        IsEnabled="{Binding ViewModel.IsPollingStarted, Converter={StaticResource ReverseBooleanConverter}}"
                        ToolTip="{x:Static lang:Resources.Split}">
                        <amur:Button.Icon>
                            <amur:SymbolIcon Symbol="BoardSplit20" />
                        </amur:Button.Icon>
                    </amur:Button>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                    <amur:Button
                        Width="28"
                        Height="28"
                        Click="btnFullScreen_Click"
                        ToolTip="{x:Static lang:Resources.Maximize}">
                        <amur:Button.Icon>
                            <amur:SymbolIcon Symbol="FullScreenMaximize20" />
                        </amur:Button.Icon>
                    </amur:Button>
                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                </StackPanel>
                <Popup
                    x:Name="popSplitMode"
                    IsOpen="{Binding ViewModel.IsSplitModePopOpen}"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=btnSplitMode}">
                    <Border>
                        <ListBox
                            x:Name="lbSplitList"
                            BorderThickness="0"
                            ItemsSource="{Binding ViewModel.SplitModeList}"
                            SelectionChanged="SplitModeListBox_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="32"
                                        Margin="{DynamicResource NormalMargin}"
                                        BorderBrush="{DynamicResource IRtek.Brushes.Button.Border}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding Item2}" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <Separator
                Height="2"
                Background="{DynamicResource IRtek.Brushes.Intervals.Background}"
                DockPanel.Dock="Bottom" />
        </DockPanel>

    </Grid>
</Page>