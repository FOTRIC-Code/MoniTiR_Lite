<Window
    x:Class="Firefly.Client.PollingGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="PlanPollingWindow"
    Width="500"
    Height="260"
    d:DataContext="{d:DesignInstance client:PollingGroupWindow,
                                     IsDesignTimeCreatable=False}"
    Loaded="Window_Loaded"
    ShowInTaskbar="False"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amur:IRtekWindowHeader
            Title="{x:Static lang:Resources.PlanPolling}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <StackPanel Grid.Row="1">
            <StackPanel
                HorizontalAlignment="Left"
                DockPanel.Dock="Top"
                Orientation="Vertical">
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        x:Name="tbName"
                        Width="300"
                        DockPanel.Dock="Right" IsEnabled="{Binding ViewModel.IsAdd}"
                        Text="{Binding ViewModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.EntityName}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Left"
                DockPanel.Dock="Top"
                Orientation="Vertical">
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <ComboBox
                        Width="300"
                        DockPanel.Dock="Right"
                        SelectedIndex="{Binding ViewModel.CycleTimeIndex}">
                        <ComboBoxItem Content="30 s" />
                        <ComboBoxItem Content="1 min" />
                        <ComboBoxItem Content="5 min" />
                        <ComboBoxItem Content="10 min" />
                    </ComboBox>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.PollingTime}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Left"
                DockPanel.Dock="Top"
                Orientation="Vertical">
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        IsEnabled="False"
                        Text="{Binding ViewModel.SplitModeDesc, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Split}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="{DynamicResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnCancel"
                Click="btnCancel_Click"
                Content="{x:Static lang:Resources.Cancel}"
                IsCancel="True" />
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <Button
                x:Name="btnSave"
                Click="btnOK_Click"
                Content="{x:Static lang:Resources.OK}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
