<UserControl
    x:Class="Firefly.Client.SplitVideoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListBox
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            BorderThickness="0"
            ItemsSource="{Binding DisplayItems}"
            SelectionChanged="ListBox_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <client:SplitItemsPanelControl Columns="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.SelectedMode.Columns}" Rows="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBox}}, Path=DataContext.SelectedMode.Rows}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type client:DisplayItemViewModel}">
                    <Border BorderBrush="{DynamicResource IRtek.Brushes.ThemeBackground.Image}" BorderThickness="1">
                        <Grid
                            Margin="1"
                            AllowDrop="True"
                            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}"
                            Drop="ListBoxItem_Drop"
                            MouseDown="Grid_MouseDown"
                            MouseEnter="Grid_MouseEnter"
                            MouseLeave="Grid_MouseLeave">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="gridNoVideo"
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Background="#01000000">
                                <Image
                                    x:Name="noDataImage"
                                    Width="32"
                                    Height="32"
                                    Source="/MoniTiRLite;component/Resources/no_video_icon.png" />
                            </Grid>

                            <Grid
                                x:Name="gridPolling"
                                Grid.RowSpan="3"
                                Visibility="Collapsed">
                                <TextBlock
                                    Grid.RowSpan="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource LargeFontSize}"
                                    Text="{Binding Description}"
                                    TextAlignment="Center" />
                                <amur:Button
                                    x:Name="btnPollingItemState"
                                    Width="28"
                                    Height="28"
                                    Margin="{DynamicResource LeftMargin}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="btnPollingItemState_Click"
                                    Icon="{amur:SymbolIcon Dismiss24}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAddPollingMode}" Value="True">
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="gridPolling" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAddPollingMode}" Value="False">
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="gridPolling" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnPollingItemState" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
                <DataTemplate DataType="{x:Type client:VideoDisplayItemViewModel}">
                    <Border BorderBrush="{DynamicResource IRtek.Brushes.ThemeBackground.Image}" BorderThickness="1">
                        <Grid
                            Margin="1"
                            AllowDrop="True"
                            Drop="ListBoxItem_Drop"
                            MouseDown="Grid_MouseDown"
                            MouseEnter="Grid_MouseEnter"
                            MouseLeave="Grid_MouseLeave">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="videoGrid"
                                Grid.RowSpan="3"
                                MouseDown="RTSPClientControl_MouseDown"
                                MouseMove="RtspControl_OnMouseMove"
                                PreviewMouseUp="RtspControl_OnMouseUp"
                                Visibility="Visible">
                                <control:RTSPClientControl
                                    x:Name="rtspControl"
                                    MinWidth="0"
                                    MinHeight="0"
                                    ConnectStatus="{Binding ConnectStatus}"
                                    DeviceArea="{Binding DeviceArea}"
                                    IsPaused="{Binding IsPaused}"
                                    RTSPUrl="{Binding RTSPUrl}"
                                    RecordStatus="{Binding RecordStatus}" />
                                <Canvas x:Name="cMask" />
                            </Grid>
                            <Grid
                                x:Name="gridNoVideo"
                                Grid.RowSpan="3"
                                Background="#01000000"
                                Visibility="Hidden">
                                <Image
                                    x:Name="noDataImage"
                                    Width="32"
                                    Height="32"
                                    Source="/MoniTiRLite;component/Resources/no_video_icon.png" />
                            </Grid>
                            <TextBlock
                                x:Name="tbError"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Bottom"
                                Text="{Binding ErrorText}"
                                Visibility="Hidden" />
                            <Grid
                                x:Name="gridTitle"
                                Grid.Row="0"
                                Width="{Binding ElementName=videoGrid, Path=ActualWidth}"
                                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    MinWidth="60"
                                    Text="{Binding Description}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Description}" />
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding RecordStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Static lang:Resources.Recording}" />
                                        <Rectangle Margin="{DynamicResource NormalMargin}" />
                                        <Path
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{DynamicResource player_record_filled}"
                                            Fill="Red"
                                            Stretch="Uniform" />
                                    </StackPanel>
                                    <StackPanel>
                                        <amur:Button
                                            Width="28"
                                            Height="28"
                                            Click="btnPin_Click">
                                            <amur:Button.Icon>
                                                <amur:SymbolIcon x:Name="fiLockBar" Symbol="Pin20" />
                                            </amur:Button.Icon>
                                        </amur:Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid
                                x:Name="gridConsole"
                                Grid.Row="2"
                                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}">
                                <amur:Button
                                    x:Name="btnCameraState"
                                    Width="28"
                                    Height="28"
                                    Margin="{DynamicResource LeftMargin}"
                                    HorizontalAlignment="Left"
                                    Click="btnCameraState_Click"
                                    Icon="{amur:SymbolIcon Stop24,
                                                           Filled=True}"
                                    ToolTip="{x:Static lang:Resources.StopPreview}" />
                                <StackPanel
                                    x:Name="gridRightPanel"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Visibility="Hidden">
                                    <amur:Button
                                        x:Name="btnConf"
                                        Width="28"
                                        Height="28"
                                        Click="btnConfigDevice_Click"
                                        Tag="{Binding ElementName=rtspControl, Path=.}"
                                        ToolTip="{x:Static lang:Resources.DeviceConfig}">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Filled="{Binding EnableDrawMask}" Symbol="ContentView20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                                    <amur:Button
                                        x:Name="btnMask"
                                        Width="28"
                                        Height="28"
                                        Click="btnMark_Click"
                                        Tag="{Binding ElementName=rtspControl, Path=.}"
                                        ToolTip="{x:Static lang:Resources.ShowMarkerTemp}"
                                        Visibility="{Binding IsShowMask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Filled="{Binding EnableDrawMask}" Symbol="DrawShape20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                                    <amur:Button
                                        x:Name="btnSnapshot"
                                        Width="28"
                                        Height="28"
                                        Click="btnSnapshot_Click"
                                        Tag="{Binding ElementName=rtspControl, Path=.}"
                                        ToolTip="{x:Static lang:Resources.Snapshot}">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Symbol="Camera20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                    <Rectangle Margin="{DynamicResource NormalMargin}" />
                                    <amur:Button
                                        x:Name="btnRecord"
                                        Width="28"
                                        Height="28"
                                        Click="btnRecord_Click"
                                        Tag="{Binding ElementName=rtspControl, Path=.}"
                                        ToolTip="{x:Static lang:Resources.Record}">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Symbol="Record20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOnline}" Value="True" />
                                <Condition Binding="{Binding HasDevice}" Value="True" />
                                <Condition Binding="{Binding ConnectStatus}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="rtspControl" Property="Visibility" Value="Visible" />
                            <Setter TargetName="tbError" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="gridRightPanel" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOnline}" Value="False" />
                                <Condition Binding="{Binding HasDevice}" Value="True" />
                                <Condition Binding="{Binding ConnectStatus}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="rtspControl" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="tbError" Property="Visibility" Value="Visible" />
                            <Setter TargetName="gridRightPanel" Property="IsEnabled" Value="False" />
                            <Setter TargetName="gridTitle" Property="IsEnabled" Value="False" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOnline}" Value="True" />
                                <Condition Binding="{Binding HasDevice}" Value="True" />
                                <Condition Binding="{Binding ConnectStatus}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="tbError" Property="Visibility" Value="Visible" />
                            <Setter TargetName="gridRightPanel" Property="IsEnabled" Value="False" />
                            <Setter TargetName="gridTitle" Property="IsEnabled" Value="False" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding HasDevice}" Value="False">
                            <Setter TargetName="gridNoVideo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="rtspControl" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="tbError" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="gridConsole" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHiddenBar}" Value="False">
                            <Setter TargetName="gridTitle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="gridConsole" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHiddenBar}" Value="True">
                            <Setter TargetName="gridTitle" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="gridConsole" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LockingBar}" Value="True">
                            <Setter TargetName="fiLockBar" Property="Symbol" Value="PinOff20" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LockingBar}" Value="False">
                            <Setter TargetName="fiLockBar" Property="Symbol" Value="Pin20" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordStatus}" Value="True">
                            <Setter TargetName="btnRecord" Property="Foreground" Value="{DynamicResource IRtek.Brushes.Danger}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>