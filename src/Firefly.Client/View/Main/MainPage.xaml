<Page
    x:Class="Firefly.Client.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1600"
    Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.GroupItem.DataGrid}" TargetType="{x:Type GroupItem}">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel Margin="{DynamicResource HugeMargin}" Orientation="Vertical">
                            <Label
                                Margin="{DynamicResource NormalMargin}"
                                VerticalAlignment="Bottom"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            <ItemsPresenter
                                x:Name="ItemsPresenter"
                                Grid.Column="1"
                                Margin="{DynamicResource LeftMargin}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ItemsControl
        Margin="98,40,98,0"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        ItemsSource="{Binding AllPages}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ItemsControl.Template>
            <ControlTemplate TargetType="{x:Type ItemsControl}">
                <Border>
                    <ScrollViewer
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        SnapsToDevicePixels="True"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter SnapsToDevicePixels="True" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border
                    x:Name="border"
                    Width="520"
                    Height="142"
                    Margin="0,12,24,12"
                    Padding="18,18,18,18"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    CornerRadius="7"
                    MouseLeftButtonUp="StackPanel_MouseLeftButtonUp"
                    Tag="{Binding}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#54617B" />
                            <GradientStop Offset="1" Color="#2A3246" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#1443506C" />
                            <GradientStop Offset="1" Color="#993B4459" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <ContentPresenter
                            Width="68"
                            Height="68"
                            Margin="0,0,14,0"
                            VerticalAlignment="Top"
                            Content="{Binding Icon}" />
                        <StackPanel
                            VerticalAlignment="Top"
                            DockPanel.Dock="Right"
                            Orientation="Vertical">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource SourceHan}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource IRtek.Brushes.ThemeForeground.Highlight}"
                                Text="{Binding Name}" />
                            <TextBlock
                                MaxHeight="78"
                                HorizontalAlignment="Left"
                                FontSize="16"
                                Foreground="{StaticResource IRtek.Brushes.ThemeForeground}"
                                Text="{Binding Description}"
                                TextTrimming="WordEllipsis"
                                TextWrapping="Wrap"
                                ToolTip="{Binding Description}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="#146B7999" />
                                    <GradientStop Offset="1" Color="#9967728B" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid HorizontalAlignment="Left" Columns="3" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</Page>
