<Window
    x:Class="Firefly.Client.DeviceDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    x:Name="root"
    MinWidth="920"
    MinHeight="680"
    control:WindowAssist.HeightRatio="0.8"
    control:WindowAssist.WidthRatio="0.8"
    Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}"
    Loaded="Window_Loaded"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <local:DeviceTypeConverter x:Key="DeviceTypeConverter" />
        <Thickness x:Key="PageMargin">20,16,20,0</Thickness>
        <Thickness x:Key="SectionGap">0,12,0,0</Thickness>
        <Thickness x:Key="FieldBlockMargin">0,0,0,4</Thickness>
        <Thickness x:Key="LabelBottomGap">0,0,0,8</Thickness>
        <Thickness x:Key="ToolbarInnerMargin">12,0</Thickness>
        <Thickness x:Key="ToolbarButtonGap">0,0,12,0</Thickness>
        <Thickness x:Key="FooterMargin">20,12,20,16</Thickness>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="64" />
        </Grid.RowDefinitions>

        <amurControls:IRtekWindowHeader x:Name="irwhTittle" ResizeMode="{Binding ResizeMode, ElementName=root}" />

        <!-- Name: label + fixed-width input, left-aligned -->
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource PageMargin}"
            Orientation="Horizontal">
            <TextBlock
                Width="72"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="{x:Static lang:Resources.EntityName}"
                TextAlignment="Right" />
            <TextBox
                Width="510"
                MinHeight="28"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding Name}" />
            <!-- Keep protocol combo in tree for code-behind; OneWay so it cannot overwrite S/D resolved from channels. -->
            <ComboBox
                x:Name="cmbServerProtocolType"
                Width="0"
                Height="0"
                Margin="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ItemsSource="{Binding ProtocolTypeList}"
                SelectedItem="{Binding SelectedProtocolType, Mode=OneWay}"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- Channels -->
        <Grid Grid.Row="2" Margin="{StaticResource PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="{StaticResource SectionGap}"
                Padding="{StaticResource ToolbarInnerMargin}"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}"
                CornerRadius="2"
                MinHeight="40">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="10,4"
                        VerticalAlignment="Center"
                        amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/search_icon.png"
                        Click="btnShowDiscovery_Click"
                        Content="{x:Static lang:Resources.OnlineChannel}"
                        MinHeight="28" />
                </StackPanel>
            </Border>

            <DataGrid
                x:Name="dgSubDeviceList"
                Grid.Row="1"
                Margin="0,10,0,0"
                VerticalAlignment="Stretch"
                amurControls:DataGridAssist.AutoRowNumber="True"
                IsEnabled="{Binding CanEditChannel}"
                IsReadOnly="True"
                ItemsSource="{Binding SubDeviceList}"
                SelectedItem="{Binding SelectedSubDevice}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding ChannelDescription}"
                        Header="{x:Static lang:Resources.Channel}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Protocol}"
                        Header="{x:Static lang:Resources.Protocol}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding IP}"
                        Header="{x:Static lang:Resources.ConnectionParam}" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Port}"
                        Header="{x:Static lang:Resources.Port}" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Mode}"
                        Header="{x:Static lang:Resources.Model}" />
                    <DataGridTemplateColumn Width="260" Header="{x:Static lang:Resources.Sn}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    HorizontalAlignment="Left"
                                    Text="{Binding Sn}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Sn}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="280"
                        Binding="{Binding Fireware}"
                        Header="{x:Static lang:Resources.FirmwareVersion}" />
                    <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.Operation}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Left"
                                        amurControls:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/edit_icon.png"
                                        Click="cbtnEdit_Click" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        amurControls:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/delete_icon.png"
                                        Click="cbtnDelete_Click"
                                        Visibility="{Binding ElementName=root, Path=DataContext.DeleteChannelBtnVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ONVIF discovery (toggle) -->
        <Grid
            Grid.Row="3"
            Margin="{StaticResource PageMargin}"
            Visibility="{Binding DiscoveryVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="{StaticResource SectionGap}"
                Padding="{StaticResource ToolbarInnerMargin}"
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}"
                CornerRadius="2"
                MinHeight="40">
                <Button
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/refresh_icon.png"
                    Click="btnStartDiscovery_Click"
                    Content="{x:Static lang:Resources.Refresh}"
                    MinHeight="28" />
            </Border>

            <DataGrid
                Grid.Row="1"
                Height="220"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                amurControls:DataGridAssist.AutoRowNumber="True"
                IsReadOnly="True"
                ItemsSource="{Binding DiscoveryCameraList}"
                SelectedItem="{Binding SelectedDiscoveryCamera}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding IP}"
                        Header="{x:Static lang:Resources.IPAddr}" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding Port}"
                        Header="{x:Static lang:Resources.Port}" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding Model}"
                        Header="{x:Static lang:Resources.Model}" />
                    <DataGridTextColumn
                        Width="1*"
                        Binding="{Binding Name}"
                        Header="{x:Static lang:Resources.EntityName}" />
                    <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.Operation}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Width="20"
                                    amurControls:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/download_icon.png"
                                    Click="btnExport2Channel_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="{StaticResource FooterMargin}">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="btnSave"
                    MinWidth="88"
                    MinHeight="30"
                    Margin="0,0,12,0"
                    Click="btnSave_Click"
                    Content="{x:Static lang:Resources.OK}"
                    IsDefault="True"
                    IsEnabled="{Binding IsSaveEnabled}" />
                <Button
                    x:Name="btnCancel"
                    MinWidth="88"
                    MinHeight="30"
                    Click="btnCancel_Click"
                    Content="{x:Static lang:Resources.Cancel}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
