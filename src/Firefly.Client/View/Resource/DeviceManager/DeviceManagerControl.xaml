<TabItem
    x:Class="Firefly.Client.DeviceManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    x:Name="root"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon LivePreview}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.DeviceManager}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <TabItem.Resources>
        <local:ServerTypeConverter x:Key="ServerTypeConverter" />
    </TabItem.Resources>
    <DockPanel>
        <Grid
            Height="32"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}"
            DockPanel.Dock="Top">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBox
                    Width="200"
                    Height="28"
                    amur:TextBoxAssist.ShowCommandButton="False"
                    amur:TextBoxAssist.Watermark="{x:Static lang:Resources.Search}"
                    PreviewKeyDown="searchBox_PreviewKeyDown"
                    Style="{StaticResource IRtek.Styles.TextBox.Search}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <amur:Button
                    HorizontalAlignment="Left"
                    Click="btnAdd_Click"
                    Content="{x:Static lang:Resources.Add}">
                    <amur:Button.Icon>
                        <amur:SymbolIcon Symbol="AddCircle20" />
                    </amur:Button.Icon>
                </amur:Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <amur:Button
                    HorizontalAlignment="Left"
                    Click="btnRefresh_Click"
                    Content="{x:Static lang:Resources.Refresh}">
                    <amur:Button.Icon>
                        <amur:SymbolIcon Symbol="ArrowSync20" />
                    </amur:Button.Icon>
                </amur:Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
            </StackPanel>
        </Grid>
        <Rectangle Margin="{DynamicResource BottomMargin}" DockPanel.Dock="Top" />
        <DockPanel Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}" DockPanel.Dock="Bottom">
            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
            <control:Pagination
                x:Name="pPagination"
                DockPanel.Dock="Right"
                PageChanged="Pagination_PageChanged" />
        </DockPanel>
        <DataGrid
            x:Name="dgCruiseRoute"
            VerticalAlignment="Stretch"
            amur:DataGridAssist.AutoRowNumber="True"
            CanUserSortColumns="True"
            DockPanel.Dock="Top"
            IsReadOnly="True"
            ItemsSource="{Binding DeviceList}"
            RowHeaderWidth="0"
            SelectedItem="{Binding SelectedItem}"
            SelectionMode="Single"
            Sorting="dgCruiseRoute_Sorting">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="{x:Static lang:Resources.EntityName}" />

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding IP}"
                    Header="{x:Static lang:Resources.ConnectionParam}">
                    <DataGridTextColumn.ElementStyle>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn
                    Width="120"
                    CanUserSort="True"
                    Header="{x:Static lang:Resources.Status}"
                    SortMemberPath="IsOnline">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource FireflyTextBlock}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource IRtek.Brushes.OK}" />
                                        <Setter Property="Text" Value="{x:Static lang:Resources.Online}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource IRtek.Brushes.Cancel}" />
                                                <Setter Property="Text" Value="{x:Static lang:Resources.Offline}" />
                                                <Setter Property="ToolTip" Value="{Binding StatusDesc}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="160" Header="{x:Static lang:Resources.Operation}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <amur:Button
                                    x:Name="cbtnDeviceConfig"
                                    HorizontalAlignment="Left"
                                    Click="cbtnDeviceConfig_Click"
                                    IsEnabled="True"
                                    Tag="{Binding}">
                                    <amur:Button.Icon>
                                        <amur:SymbolIcon Symbol="ContentView20" />
                                    </amur:Button.Icon>
                                    <amur:Button.Style>
                                        <Style BasedOn="{StaticResource IRtek.Styles.Button.Icon}" TargetType="{x:Type amur:Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="{x:Static service:DeviceStatus.Offline}">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsOnline}" Value="{x:Static service:DeviceStatus.Online}" />
                                                        <Condition Binding="{Binding EnableConfig}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsOnline}" Value="{x:Static service:DeviceStatus.Offline}" />
                                                        <Condition Binding="{Binding EnableConfig}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </amur:Button.Style>
                                </amur:Button>
                                <Rectangle Margin="{DynamicResource NormalMargin}" />
                                <amur:Button
                                    HorizontalAlignment="Left"
                                    Click="cbtnEdit_Click"
                                    Tag="{Binding}">
                                    <amur:Button.Icon>
                                        <amur:SymbolIcon Symbol="Edit20" />
                                    </amur:Button.Icon>
                                </amur:Button>
                                <Rectangle Margin="{DynamicResource NormalMargin}" />
                                <amur:Button
                                    HorizontalAlignment="Left"
                                    Click="cbtnDelete_Click"
                                    Tag="{Binding}">
                                    <amur:Button.Icon>
                                        <amur:SymbolIcon Symbol="Delete20" />
                                    </amur:Button.Icon>
                                </amur:Button>
                                <Rectangle Margin="{DynamicResource NormalMargin}" />
                                <amur:Button HorizontalAlignment="Left" Click="btnInfo_Click">
                                    <amur:Button.Icon>
                                        <amur:SymbolIcon Symbol="Info20" />
                                    </amur:Button.Icon>
                                </amur:Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTemplateColumn Header="{x:Static lang:Resources.Edit}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{x:Static lang:Resources.Delete}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</TabItem>
