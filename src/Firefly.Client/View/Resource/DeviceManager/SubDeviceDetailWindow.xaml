<Window
    x:Class="Firefly.Client.SubDeviceDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    x:Name="root"
    Title="SubDeviceControl"
    Width="480"
    MinWidth="480"
    MinHeight="380"
    Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}"
    Loaded="SubDeviceDetailWindow_Loaded"
    SizeToContent="Height"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{Binding Title}" ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1">
            <StackPanel
                Margin="{DynamicResource LeftMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <StackPanel.Resources>
                    <control:ValidationRang
                        x:Key="PortRang"
                        Maximum="65535"
                        Minimum="0"
                        TargetType="system:Int32" />
                </StackPanel.Resources>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <ComboBox
                        x:Name="cmbProtocol"
                        Width="300"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding ProtocolList}"
                        SelectedValue="{Binding SubDeviceVM.Protocol}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Protocol}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding SubDeviceVM.IP}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.ConnectionParam}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding SubDeviceVM.Port, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource PortRang}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Port}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" Visibility="{Binding UserNameVisibility}" />
                <DockPanel Visibility="{Binding UserNameVisibility}">
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding SubDeviceVM.Username}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Username}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" Visibility="{Binding PasswordVisibility}" />
                <DockPanel Visibility="{Binding PasswordVisibility}">
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding SubDeviceVM.Password}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Password}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" Visibility="{Binding ChannelListVisibility}" />
                <DockPanel Visibility="{Binding ChannelListVisibility}">
                    <ComboBox
                        Width="300"
                        DisplayMemberPath="DeviceTypeDescript"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding SubDeviceVM.DeviceTypes}"
                        SelectedItem="{Binding SubDeviceVM.CurrentSubDeviceTypeItem}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.ChannelType}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" Visibility="{Binding ChannelListVisibility}" />
                <DockPanel Visibility="{Binding ChannelListVisibility}">
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding SubDeviceVM.ParamID}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.ChannelNo}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
            <StackPanel
                Grid.Row="2"
                Margin="{DynamicResource LargeMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="btnSave"
                    Click="btnSave_Click"
                    Content="{x:Static lang:Resources.OK}"
                    IsDefault="True"
                    IsEnabled="{Binding IsSaveEnabled}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button
                    x:Name="btnCancel"
                    Click="btnCancel_Click"
                    Content="{x:Static lang:Resources.Cancel}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
