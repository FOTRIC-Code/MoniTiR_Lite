<Page
    x:Class="Firefly.Client.ResourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="ResourcePage_Loaded"
    mc:Ignorable="d">
    <TabControl
        x:Name="tcResource"
        Margin="{DynamicResource BottomMargin}"
        Padding="{DynamicResource LeftTopMargin}"
        Style="{StaticResource IRtek.Styles.TabControl.Classic}"
        TabStripPlacement="Left">
        <local:DeviceManagerControl />
        <local:StorePlanningControl />
    </TabControl>
</Page>
