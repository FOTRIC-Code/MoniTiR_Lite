<Window
    x:Class="Firefly.Client.NVREditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="NVREditWindow"
    Width="480"
    MinWidth="480"
    MinHeight="430"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader
            Title="{Binding Title}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <StackPanel
            Grid.Row="1"
            Margin="{DynamicResource LeftMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    x:Name="tbName"
                    Width="300"
                    DockPanel.Dock="Right"
                    Text="{Binding Name}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.EntityName}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <ComboBox
                    Width="300"
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding ProtocolTypeList}"
                    SelectedItem="{Binding ProtocolType}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    Text="{x:Static lang:Resources.Protocol}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    x:Name="tbIP"
                    Width="300"
                    DockPanel.Dock="Right"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding IP}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    Text="{x:Static lang:Resources.Address}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    x:Name="tbPort"
                    Width="300"
                    DockPanel.Dock="Right"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    Text="{x:Static lang:Resources.Port}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    Width="300"
                    DockPanel.Dock="Right"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding UserName}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    Text="{x:Static lang:Resources.Username}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    Width="300"
                    DockPanel.Dock="Right"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding Password}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    Text="{x:Static lang:Resources.Password}"
                    TextAlignment="Right" />
            </DockPanel>
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="{DynamicResource LargeMargin}"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <Button
                x:Name="btnCancel"
                Click="btnCancel_Click"
                Content="{x:Static lang:Resources.Cancel}" />
        </StackPanel>
    </Grid>
</Window>
