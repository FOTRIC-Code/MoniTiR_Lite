<Window
    x:Class="Firefly.Client.StoreServerConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="StoreServerConfigWindow"
    Width="1000"
    Height="500"
    MinWidth="500"
    MinHeight="250"
    Loaded="Window_Loaded"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader
            Title="{x:Static lang:Resources.ServerConfig}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1" Margin="{StaticResource LargeMargin}">
            <Border
                Height="32"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Menu}"
                DockPanel.Dock="Top">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <amurControls:Button
                        HorizontalAlignment="Left"
                        BorderThickness="1"
                        Click="btnAdd_Click"
                        Content="{x:Static lang:Resources.Add}">
                        <amurControls:Button.Icon>
                            <amurControls:SymbolIcon Symbol="AddCircle20" />
                        </amurControls:Button.Icon>
                    </amurControls:Button>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <amurControls:Button
                        HorizontalAlignment="Left"
                        BorderThickness="1"
                        Click="btnRefresh_Click"
                        Content="{x:Static lang:Resources.Refresh}">
                        <amurControls:Button.Icon>
                            <amurControls:SymbolIcon Symbol="ArrowSync20" />
                        </amurControls:Button.Icon>
                    </amurControls:Button>
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                </StackPanel>
            </Border>
            <Rectangle Margin="{StaticResource NormalMargin}" DockPanel.Dock="Top" />
            <DataGrid
                x:Name="dgStore"
                amurControls:DataGridAssist.AutoRowNumber="True"
                CanUserAddRows="False"
                DockPanel.Dock="Right"
                ItemsSource="{Binding Items}"
                SelectedIndex="0"
                SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="{DynamicResource LeftMargin}"
                                    HorizontalAlignment="Left"
                                    Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="240"
                        Binding="{Binding Name}"
                        Header="{x:Static lang:Resources.EntityName}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding ProtocolType}"
                        Header="{x:Static lang:Resources.Protocol}" />
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding Address}"
                        Header="{x:Static lang:Resources.Address}" />
                    <DataGridTemplateColumn Width="120" Header="{x:Static lang:Resources.Operation}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        HorizontalAlignment="Left"
                                        amurControls:ButtonAssist.Image="pack://application:,,,/Resources/edit_icon.png"
                                        Click="btnEdit_Click" />
                                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        amurControls:ButtonAssist.Image="pack://application:,,,/Resources/delete_icon.png"
                                        Click="btnDelete_Click"
                                        IsEnabled="{Binding CanDelete}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
