<TabItem
    x:Class="Firefly.Client.StorePlanningControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    x:Name="root"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Store}"
    d:DataContext="{d:DesignInstance client:StorePlanningControl,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.StorePlan}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            Height="32"
            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Menu}"
            DockPanel.Dock="Top">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="btnNvrManage"
                    Margin="{DynamicResource RightMargin}"
                    Click="btnNvrManage_Click"
                    Content="{x:Static lang:Resources.NVRManage}" />
            </StackPanel>
        </Border>
        <TreeView
            Width="241"
            BorderThickness="0"
            DockPanel.Dock="Left"
            ItemsSource="{Binding ViewModel.Items}"
            SelectedItemChanged="tvDevice_SelectedItemChanged">
            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Color, Source={StaticResource ControlSelectedBrush}}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Color, Source={StaticResource ControlSelectedBrush}}" />
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type client:StorePlanningNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel
                        x:Name="spItem"
                        Width="180"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="{StaticResource NormalMargin}"
                            Text="{Binding Name}"
                            TextTrimming="WordEllipsis" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <DockPanel Margin="{StaticResource LeftMargin}" DockPanel.Dock="Right">
            <Grid DockPanel.Dock="Bottom">
                <StackPanel
                    Margin="{DynamicResource TopMargin}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    DockPanel.Dock="Bottom">
                    <Button
                        Margin="{DynamicResource RightMargin}"
                        Click="btnChannelSave_Click"
                        Content="{x:Static lang:Resources.Save}"
                        IsDefault="True"
                        IsEnabled="{Binding ViewModel.SelectedDevice.IsDeviceChannel}" />
                </StackPanel>
            </Grid>
            <Grid
                Background="{StaticResource IRtek.Brushes.ThemeBackground.Content}"
                DockPanel.Dock="Top"
                IsEnabled="{Binding ViewModel.HasSelectedDevice}">
                <StackPanel
                    Margin="{DynamicResource LeftMargin}"
                    HorizontalAlignment="Left"
                    Orientation="Vertical">
                    <Rectangle Height="{DynamicResource IntervalsHeight}" />
                    <DockPanel>
                        <ComboBox
                            x:Name="cmbNVR"
                            Width="300"
                            DisplayMemberPath="Name"
                            DockPanel.Dock="Right"
                            IsEnabled="{Binding ViewModel.SelectedDevice.IsDeviceChannel}"
                            ItemsSource="{Binding ViewModel.NVRItems}"
                            SelectedItem="{Binding ViewModel.SelectedNVR}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                        <TextBlock
                            MinWidth="120"
                            DockPanel.Dock="Left"
                            Text="{x:Static lang:Resources.StoreDevice}"
                            TextAlignment="Right" />
                    </DockPanel>
                    <Rectangle Height="{DynamicResource IntervalsHeight}" />
                    <DockPanel IsEnabled="{Binding ViewModel.SelectedDevice.IsDeviceChannel}">
                        <ComboBox
                            x:Name="cmbChannel"
                            Width="300"
                            DisplayMemberPath="Name"
                            DockPanel.Dock="Right"
                            ItemsSource="{Binding ViewModel.NVRChannelItems}"
                            MaxDropDownHeight="{Binding ElementName=root, Path=Height}"
                            SelectedItem="{Binding ViewModel.SelectedNVRChannel}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                        <TextBlock
                            MinWidth="120"
                            DockPanel.Dock="Left"
                            Text="{x:Static lang:Resources.Channel}"
                            TextAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

    </DockPanel>
</TabItem>