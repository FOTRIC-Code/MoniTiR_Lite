<Window
    x:Class="Firefly.Client.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControl="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    Title="SplashWindow"
    Width="600"
    Height="400"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None">
    <Grid>
        <StackPanel
            Width="600"
            Height="425"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource IRtekBrush}">
            <Image
                x:Name="imgSplash"
                Width="600"
                Height="400"
                Stretch="None" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    x:Name="UpdateMessageTextBox"
                    Effect="{x:Null}"
                    FontSize="16"
                    Text="Loading" />
                <TextBlock
                    x:Name="EllipsesTextBlock"
                    Width="20"
                    Margin="0,0,0,0"
                    Effect="{x:Null}"
                    FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="...." />
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard Storyboard.TargetProperty="Text">
                                            <ObjectAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="00:00:1">
                                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="" />
                                                <DiscreteObjectKeyFrame KeyTime="00:00:0.25" Value="." />
                                                <DiscreteObjectKeyFrame KeyTime="00:00:0.5" Value=".." />
                                                <DiscreteObjectKeyFrame KeyTime="00:00:0.75" Value="..." />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
