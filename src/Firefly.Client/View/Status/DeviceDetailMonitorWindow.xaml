<Window
    x:Class="Firefly.Client.DeviceDetailMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    x:Name="root"
    Title="PointMonitorWindow"
    Width="850"
    Height="800"
    Closed="DeviceDetailMonitorWindow_OnClosed"
    ShowInTaskbar="False"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <local:ChartDoubleToDateTimeConverter x:Key="ChartDoubleToDateTimeConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:IRtekWindowHeader
            Title="{x:Static lang:Resources.DeviceDetail}"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <ScrollViewer
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <StackPanel
                        Height="34"
                        Margin="{DynamicResource TopBottomMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        Orientation="Horizontal">
                        <Border
                            Width="2"
                            Margin="{DynamicResource NormalMargin}"
                            Background="{StaticResource IRtek.Brushes.Highlight}" />
                        <TextBlock Text="{x:Static lang:Resources.BasicInfomation}" />
                    </StackPanel>
                    <Grid Margin="{DynamicResource LeftMargin}" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Static lang:Resources.DeviceName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding DeviceDO.Name, StringFormat={}: {0:}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical">
                            <TextBlock HorizontalAlignment="Right" Text="{x:Static lang:Resources.DeviceName}" />
                            <TextBlock HorizontalAlignment="Right" Text="{x:Static lang:Resources.MeasurementTime}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Vertical">
                            <TextBlock Text="{Binding DeviceDO.Name, StringFormat={}: {0:}}" />
                            <TextBlock
                                Text="{Binding MeasurementTime, StringFormat={}: {0:yyyy-MM-dd HH:mm:ss}, IsAsync=True, FallbackValue=': -', TargetNullValue=': -'}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <StackPanel
                        Height="34"
                        Margin="{DynamicResource TopBottomMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        Orientation="Horizontal">
                        <Border
                            Width="2"
                            Margin="{DynamicResource NormalMargin}"
                            Background="{StaticResource IRtek.Brushes.Highlight}" />
                        <TextBlock Text="{x:Static lang:Resources.RealTimeMonitor}" />
                    </StackPanel>
                    <DataGrid
                        Margin="{DynamicResource LeftMargin}"
                        controls:DataGridAssist.AutoRowNumber="True"
                        ItemsSource="{Binding ChannelInfoList}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50" Header="{x:Static lang:Resources.Order}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Type}"
                                Header="{x:Static lang:Resources.Channel}" />
                            <DataGridTextColumn
                                Width="250"
                                Binding="{Binding Detail}"
                                Header="{x:Static lang:Resources.DataValue}" />
                            <DataGridTemplateColumn Width="300" Header="{x:Static lang:Resources.Picture}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type client:VideoViewModel}">
                                        <Grid
                                            Width="300"
                                            Height="200"
                                            Margin="{DynamicResource NormalMargin}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                x:Name="border"
                                                Background="{DynamicResource DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                                                Visibility="Collapsed" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <control:IRtekImage
                                                    x:Name="imgPicture"
                                                    Width="300"
                                                    Height="200"
                                                    Margin="{DynamicResource NormalMargin}"
                                                    IsEnabled="{Binding IsEnable}"
                                                    Source="{Binding ImageUrl}" />
                                                <TextBlock
                                                    x:Name="tbNoData"
                                                    HorizontalAlignment="Center"
                                                    Text="{x:Static lang:Resources.NoPicture}"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                                <Setter TargetName="imgPicture" Property="Source" Value="/MoniTiRLite;component/Resources/no_picture_icon.png" />
                                                <Setter TargetName="imgPicture" Property="Width" Value="80" />
                                                <Setter TargetName="imgPicture" Property="Height" Value="80" />
                                                <Setter TargetName="tbNoData" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Vertical">
                    <StackPanel
                        Height="34"
                        Margin="{DynamicResource TopBottomMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                        Orientation="Horizontal">
                        <Border
                            Width="2"
                            Margin="{DynamicResource NormalMargin}"
                            Background="{StaticResource IRtek.Brushes.Highlight}" />
                        <TextBlock Text="{x:Static lang:Resources.MeasurementPlot}" />
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <oxy:PlotView
                            x:Name="pvLine"
                            Height="300"
                            Margin="{DynamicResource LeftMargin}"
                            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                            Controller="{Binding MouseHoverController}"
                            Model="{Binding PlotDataModel}">
                            <oxy:PlotView.DefaultTrackerTemplate>
                                <ControlTemplate>
                                    <oxy:TrackerControl
                                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                                        HorizontalLineVisibility="Collapsed"
                                        LineExtents="{Binding PlotModel.PlotArea}"
                                        Position="{Binding Position}">
                                        <oxy:TrackerControl.Content>
                                            <StackPanel
                                                Canvas.Left="{Binding Position.X}"
                                                Canvas.Top="{Binding Position.Y}"
                                                Margin="6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Series.Title}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.Time}" />
                                                    <TextBlock FontWeight="Bold" Text=":" />
                                                    <TextBlock Text="{Binding DataPoint.X, Converter={StaticResource ChartDoubleToDateTimeConverter}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.DataValue}" />
                                                    <TextBlock FontWeight="Bold" Text=":" />
                                                    <TextBlock Text="{Binding DataPoint.Y, StringFormat={}{0:F1}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </oxy:TrackerControl.Content>
                                    </oxy:TrackerControl>
                                </ControlTemplate>
                            </oxy:PlotView.DefaultTrackerTemplate>
                        </oxy:PlotView>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
