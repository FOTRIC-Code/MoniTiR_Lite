<Window x:Class="Firefly.Client.RealTimeMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
        xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
        xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
        mc:Ignorable="d" Background="{StaticResource ControlLightLightBrush}"
        Closed="RealTimeMonitorWindow_OnClosed"
        xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
        xmlns:client="clr-namespace:Firefly.Client"
        x:Name="root"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ResizableDialogWindow}" Height="1040" Loaded="root_Loaded">
    <Window.Resources>
        <DataTemplate x:Key="PresetListBoxDataTemplate" DataType="{x:Type client:RealTimePresetItemViewModel}">
            <Grid Margin="{StaticResource NormalMargin}">
                <TextBlock Text="{Binding Name}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CruiseListBoxDataTemplate" DataType="{x:Type client:RealTimeCruiseItemViewModel}">
            <Grid Margin="{StaticResource NormalMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Grid.Column="0" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/play_icon.png" Click="cbtnCruisePlay_Click" />
                    <Rectangle Margin="{StaticResource NormalMargin}"></Rectangle>
                    <Button Grid.Column="1" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/stop_icon.png" Click="cbtnCruisePause_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource ControlLightLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{x:Static lang:Resources.ReaTimeMonitor}" ResizeMode="{Binding ResizeMode,ElementName=root}"></amurControls:IRtekWindowHeader>
        <Grid Grid.Row="1" Margin="{StaticResource NormalMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource ControlDarkBrush}" BorderThickness="1,1,1,1" Width="650" Height="490" />
                        <control:RTSPClientControl x:Name="irClient" Width="640" Height="480" RTSPUrl="{Binding IRRTSPUrl,Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Border Background="{StaticResource ControlDarkBrush}" BorderThickness="1,1,1,1" Width="650" Height="490" />
                        <control:RTSPClientControl x:Name="dcClient" Grid.Row="1" Width="640" Height="480" HorizontalAlignment="Center" RTSPUrl="{Binding DCRTSPUrl,Mode=OneWay}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical">
                    <Rectangle Margin="{StaticResource NormalMargin}" />
                    <!-- 热像调焦 自动对焦 -->
                    <StackPanel Orientation="Horizontal" Background="{StaticResource ControlDarkBrush}">
                        <Button x:Name="btnFireFocusDown" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_down_icon.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.FOCUS_NEAR}" />
                        <Button x:Name="btnAutoFocus" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/auto_focus_icon.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.FOCUS_AUTO}" />
                        <Button x:Name="btnFireFocusUp" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_up_icon.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.FOCUS_FAR}" />
                        <Button x:Name="btnDoWiper" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/wiper_icon.png" Click="btnDoWiper_Click" Tag="{x:Static service:PTZCommand.WIPER}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <!-- 云台操作 -->
                        <UniformGrid Grid.Column="0" Columns="3" Rows="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle />
                            <Button x:Name="btnMoveU" Width="40" amurControls:ButtonAssist.ImageHeight="32" amurControls:ButtonAssist.ImageWidth="32" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_u.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.TILT_UP}" />
                            <Rectangle />
                            <Button x:Name="btnMoveL" Width="40" amurControls:ButtonAssist.ImageHeight="32" amurControls:ButtonAssist.ImageWidth="32" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_l.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.PAN_LEFT}" />
                            <Rectangle />
                            <Button x:Name="btnMoveR" Width="40" amurControls:ButtonAssist.ImageHeight="32" amurControls:ButtonAssist.ImageWidth="32" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_r.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.PAN_RIGHT}" />
                            <Rectangle />
                            <Button x:Name="btnMoveD" Width="40" amurControls:ButtonAssist.ImageHeight="32" amurControls:ButtonAssist.ImageWidth="32" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/arrow_d.png" PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp" Tag="{x:Static service:PTZCommand.TILT_DOWN}" />
                            <Rectangle />
                        </UniformGrid>
                        <Slider x:Name="sldSpeed" Grid.Column="1" Minimum="1" Maximum="10" Width="20" Height="160" Value="5" Orientation="Vertical" Style="{StaticResource VerticalSlider}" HorizontalAlignment="Left" />
                    </Grid>
                    <!-- 对焦 光圈 变倍 -->
                    <Grid HorizontalAlignment="Center" IsEnabled="{Binding HasVisualVideo}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                            <Button x:Name="btnVisionFocusUp" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_up_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Focus}" Tag="{x:Static service:PTZCommand.FOCUS_FAR}" />
                            <Rectangle Margin="{StaticResource LargeMargin}" />
                            <Button x:Name="btnVisionFocusDown" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/focus_down_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Focus}" Tag="{x:Static service:PTZCommand.FOCUS_NEAR}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                            <Button x:Name="btnVisionLightUp" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/aperture_up_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Aperture}" Tag="{x:Static service:PTZCommand.IRIS_OPEN}" />
                            <Rectangle Margin="{StaticResource LargeMargin}" />
                            <Button x:Name="btnVisionLightDown" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/aperture_down_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Aperture}" Tag="{x:Static service:PTZCommand.IRIS_CLOSE}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                            <Button x:Name="btnVisionTimesUp" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/zoom_up_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Zoom}" Tag="{x:Static service:PTZCommand.ZOOM_IN}" />
                            <Rectangle Margin="{StaticResource LargeMargin}" />
                            <Button x:Name="btnVisionTimesDown" Margin="{DynamicResource LargeMargin}" amurControls:ButtonAssist.Image="/MoniTiRLite;component/Resources/zoom_down_icon.png" PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown" PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp" ToolTip="{x:Static lang:Resources.Zoom}" Tag="{x:Static service:PTZCommand.ZOOM_OUT}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TabControl Grid.Row="2" TabStripPlacement="Top" Margin="{StaticResource NormalMargin}">
                    <TabItem BorderThickness="0" Width="145" Header="{x:Static lang:Resources.Preset}">
                        <ListBox SelectedItem="{Binding SelectedPreset}" ItemsSource="{Binding PresetItems}" ItemTemplate="{StaticResource PresetListBoxDataTemplate}" />
                    </TabItem>
                    <TabItem BorderThickness="0" Width="145" Header="{x:Static lang:Resources.Cruise}">
                        <ListBox ItemsSource="{Binding CruiseItems}" ItemTemplate="{StaticResource CruiseListBoxDataTemplate}"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
