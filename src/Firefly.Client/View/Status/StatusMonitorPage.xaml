<Page
    x:Class="Firefly.Client.StatusMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    x:Name="root"
    Title="StatusMonitorPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource IRtek.Brushes.ThemeForeground}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <client:ChartDoubleToDateTimeConverter x:Key="ChartDoubleToDateTimeConverter" />
    </Page.Resources>
    <Grid Margin="{DynamicResource TopBottomMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <UniformGrid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Navbar}"
            Columns="4"
            Rows="1">
            <UniformGrid
                Width="200"
                Height="100"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.03}"
                Columns="1"
                Rows="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Static lang:Resources.Device}"
                    TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding TotalDeviceCount}" />
            </UniformGrid>
            <UniformGrid
                Width="200"
                Height="100"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.03}"
                Columns="1"
                Rows="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Static lang:Resources.OnlineDevice}"
                    TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding TotalOnlineDevices}" />
            </UniformGrid>
            <UniformGrid
                Width="200"
                Height="100"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.03}"
                Columns="1"
                Rows="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Static lang:Resources.AlarmDevice}"
                    TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding TotalAlarmDeviceCount}" />
            </UniformGrid>
            <UniformGrid
                Width="200"
                Height="100"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.03}"
                Columns="1"
                Rows="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Static lang:Resources.UnconfirmedAlarmMessage}"
                    TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding TotalUnconfirmedAlarmCount}" />
            </UniformGrid>
        </UniformGrid>
        <ItemsControl
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource IRtek.Brushes.ItemsControl.Background}"
            BorderThickness="0"
            ItemsSource="{Binding DeviceItems}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ItemsControl.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IRtek.Styles.GroupItem.DataGrid}">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type client:DeviceItemViewModel}">
                    <Grid
                        Width="240"
                        Height="130"
                        VerticalAlignment="Stretch"
                        MouseLeftButtonDown="DeviceList_ItemMouseLeftButtonDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="border"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Background="{DynamicResource IRtek.Brushes.ThemeBackground.03}" />
                        <!--  title  -->
                        <Grid Grid.Row="0" Margin="{DynamicResource NormalMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="{StaticResource NormalMargin}"
                                Text="{Binding DeviceName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTip="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Width="25"
                                    Height="25"
                                    amur:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/alarm_out_icon.png"
                                    Click="ToggleAlarmOutput_OnClick"
                                    IsEnabled="{Binding IsOnline}"
                                    ToolTip="{x:Static lang:Resources.AlarmOutAction}" />
                                <Rectangle Margin="{StaticResource NormalMargin}" />
                                <Button
                                    Width="25"
                                    Height="25"
                                    amur:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/resume_cruise_icon.png"
                                    Click="ResumeCruise_OnClick"
                                    IsEnabled="{Binding IsOnline}"
                                    ToolTip="{x:Static lang:Resources.ResumeCruise}" />
                                <Rectangle Margin="{StaticResource NormalMargin}" />
                                <Button
                                    Width="25"
                                    Height="25"
                                    amur:ButtonAssist.Image="pack://application:,,,/MoniTiRLite;component/Resources/real_time_monitor_icon.png"
                                    Click="RealTimeMonitor_OnClick"
                                    IsEnabled="{Binding IsOnline}"
                                    ToolTip="{x:Static lang:Resources.ReaTimeMonitor}" />
                                <Rectangle Margin="{StaticResource NormalMargin}" />
                                <Image
                                    x:Name="imgAlarm"
                                    Width="19"
                                    Height="19"
                                    Source="/MoniTiRLite;component/Resources/alarm_light_white_icon.png" />
                                <Rectangle Margin="{StaticResource NormalMargin}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource IRtek.Brushes.Separator.DataGrid.Background}" />
                        <Grid
                            Grid.Row="1"
                            Margin="{DynamicResource NormalMargin}"
                            ToolTip="{Binding Message}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    VerticalAlignment="Top"
                                    PreviewMouseLeftButtonDown="DeviceList_ItemMouseLeftButtonDown"
                                    Text="{Binding Message}"
                                    TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource IRtek.Styles.TextBlock.Classic}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
                                            <Setter Property="FontFamily" Value="{StaticResource SourceHanLight}" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="{x:Static lang:Resources.NoData}">
                                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="Margin" Value="0,28,0,0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Opacity" Value="0.56" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAlarmed}" Value="True">
                            <Setter TargetName="imgAlarm" Property="Source" Value="/MoniTiRLite;component/Resources/alarm_light_red_icon.png" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAlarmed}" Value="False">
                            <Setter TargetName="imgAlarm" Property="Source" Value="/MoniTiRLite;component/Resources/alarm_light_white_icon.png" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemHeight="150" ItemWidth="268" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Style>
                <Style BasedOn="{StaticResource {x:Type ItemsControl}}" TargetType="{x:Type ItemsControl}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <ScrollViewer Background="{DynamicResource IRtek.Brushes.ItemsControl.Background}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>
        <UniformGrid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="{DynamicResource LeftMargin}"
            Columns="1"
            Rows="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <control:RTSPClientControl
                    x:Name="rtspVideo1"
                    Grid.Row="0"
                    Width="480"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Navbar}"
                    BorderBrush="{DynamicResource IRtek.Brushes.ItemsControl.BorderBrush}"
                    RTSPUrl="{Binding FirstVideoRTSPUrl}" />
                <Border Visibility="{Binding ElementName=rtspVideo1, Path=IsPaused, Converter={StaticResource LogicToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Image
                            Width="100"
                            Height="80"
                            Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                        <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.NoVideo}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <control:RTSPClientControl
                    x:Name="rtspVideo2"
                    Width="480"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Navbar}"
                    BorderBrush="{DynamicResource IRtek.Brushes.ItemsControl.BorderBrush}"
                    RTSPUrl="{Binding LastVideoRTSPUrl}" />
                <Border BorderThickness="0" Visibility="{Binding ElementName=rtspVideo2, Path=IsPaused, Converter={StaticResource LogicToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Image
                            Width="100"
                            Height="80"
                            Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                        <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.NoVideo}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <oxy:PlotView
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Navbar}"
                    BorderBrush="{DynamicResource IRtek.Brushes.ItemsControl.BorderBrush}"
                    BorderThickness="0"
                    Controller="{Binding MouseHoverController}"
                    Model="{Binding PlotDataModel}"
                    Visibility="{Binding HasPointPlot, Converter={StaticResource BoolToVisibilityConverter}}">
                    <oxy:PlotView.DefaultTrackerTemplate>
                        <ControlTemplate>
                            <oxy:TrackerControl
                                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                                HorizontalLineVisibility="Collapsed"
                                LineExtents="{Binding PlotModel.PlotArea}"
                                Position="{Binding Position}">
                                <oxy:TrackerControl.Content>
                                    <StackPanel
                                        Canvas.Left="{Binding Position.X}"
                                        Canvas.Top="{Binding Position.Y}"
                                        Margin="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Series.Title}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.Time}" />
                                            <TextBlock FontWeight="Bold" Text=":" />
                                            <TextBlock Text="{Binding DataPoint.X, Converter={StaticResource ChartDoubleToDateTimeConverter}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="Bold" Text="{x:Static lang:Resources.DataValue}" />
                                            <TextBlock FontWeight="Bold" Text=":" />
                                            <TextBlock Text="{Binding DataPoint.Y, StringFormat={}{0:F1}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </oxy:TrackerControl.Content>
                            </oxy:TrackerControl>
                        </ControlTemplate>
                    </oxy:PlotView.DefaultTrackerTemplate>
                </oxy:PlotView>
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Navbar}"
                    BorderBrush="{DynamicResource IRtek.Brushes.ItemsControl.BorderBrush}"
                    BorderThickness="0"
                    Visibility="{Binding HasPointPlot, Converter={StaticResource ReverseLogicToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Image
                            Width="100"
                            Height="80"
                            Source="/MoniTiRLite;component/Resources/no_data_icon.png" />
                        <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.NoPlotData}" />
                    </StackPanel>
                </Border>
            </Grid>
        </UniformGrid>
    </Grid>
</Page>
