<TabItem
    x:Class="Firefly.Client.ImageCanvasConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    amur:TabItemAssist.Icon="{control:SymbolIcon LivePreview}"
    d:DataContext="{d:DesignInstance local:ImageCanvasConfigControl,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="ImageCanvasConfigControl_Loaded"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">

    <Grid Background="{StaticResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource LargeMargin}" Background="{StaticResource IRtek.Brushes.ThemeBackground.Content}">
                <StackPanel
                    Margin="{DynamicResource LeftMargin}"
                    HorizontalAlignment="Left"
                    Orientation="Vertical">
                    <Rectangle Height="{DynamicResource IntervalsHeight}" />
                    <DockPanel>
                        <ComboBox
                            x:Name="cbRenderMode"
                            Width="300"
                            DockPanel.Dock="Right"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{x:Static lang:Resources.FitMode}" />
                            <ComboBoxItem Content="{x:Static lang:Resources.FillMode}" />
                        </ComboBox>
                        <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                        <TextBlock
                            MinWidth="120"
                            DockPanel.Dock="Left"
                            Text="{x:Static lang:Resources.RenderMode}"
                            TextAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource RightMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</TabItem>
