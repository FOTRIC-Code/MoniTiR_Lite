<Page
    x:Class="Firefly.Client.SystemConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:client="clr-namespace:Firefly.Client"
    xmlns:controls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SystemConfigPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="SystemConfigPage_OnLoaded"
    mc:Ignorable="d">
    <TabControl
        Margin="{DynamicResource BottomMargin}"
        Style="{StaticResource IRtek.Styles.TabControl.Classic}"
        TabStripPlacement="Left">
        <client:CommonConfigControl
            x:Name="CommonConfig"
            Width="{StaticResource DefaultTabItemWidth}"
            Header="{x:Static lang:Resources.CommonConfig}"
            IsSelected="True" />
        <client:ImageCanvasConfigControl Width="{StaticResource DefaultTabItemWidth}" Header="{x:Static lang:Resources.ImageCanvas}" />
        <client:CustomSoftwareControl Width="{StaticResource DefaultTabItemWidth}" Header="{x:Static lang:Resources.CustomSystem}" />
    </TabControl>
</Page>
