<Window
    x:Class="Firefly.Client.Control.Fire.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    MinWidth="1000"
    MinHeight="650"
    control:WindowAssist.HeightRatio="0.99"
    control:WindowAssist.WidthRatio="0.96"
    Closed="MainWindow_OnClosed"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader
            x:Name="title"
            Title="{x:Static lang:Resources.DeviceConfig}"
            Grid.Row="0"
            FontSize="{StaticResource LargeFontSize}"
            ResizeMode="{Binding ElementName=root, Path=ResizeMode}" />
        <Border
            Grid.Row="1"
            Height="32"
            Margin="{DynamicResource TopBottomMargin}"
            Background="{StaticResource IRtek.Brushes.ThemeBackground.Toolbar}">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Horizontal">
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <amurControls:Button
                    x:Name="btnExport"
                    BorderThickness="1"
                    Click="btnExport_Click"
                    Content="{x:Static lang:Resources.Export}">
                    <amurControls:Button.Icon>
                        <control:SymbolIcon FontSize="18" Symbol="Export" />
                    </amurControls:Button.Icon>
                </amurControls:Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <amurControls:Button
                    x:Name="btnImport"
                    BorderThickness="1"
                    Click="btnImport_Click"
                    Content="{x:Static lang:Resources.Import}">
                    <amurControls:Button.Icon>
                        <control:SymbolIcon FontSize="18" Symbol="Import" />
                    </amurControls:Button.Icon>
                </amurControls:Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <amurControls:Button
                    x:Name="btnCopyTo"
                    BorderThickness="1"
                    Click="btnCopyTo_Click"
                    Content="{x:Static lang:Resources.CopyTo}">
                    <amurControls:Button.Icon>
                        <control:SymbolIcon FontSize="18" Symbol="Copy" />
                    </amurControls:Button.Icon>
                </amurControls:Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
            </StackPanel>
        </Border>
        <TabControl
            x:Name="tcHeader"
            Grid.Row="2"
            TabStripPlacement="Left">
            <local:GeneralControl x:Name="gcGeneral" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:EventTriggerControl x:Name="etcEventTrigger" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:OSDConfigControl x:Name="osdConfig" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:PresetControl x:Name="pcPreset" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:CruiseRouteControl x:Name="crcCruiseRoute" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:TaskScheduleControl x:Name="tscTaskSchedule" PreviewMouseDown="tabItem_PreviewMouseDown" />
            <local:AlarmScheduleControl x:Name="ascAlarmSchedule" PreviewMouseDown="tabItem_PreviewMouseDown" />
        </TabControl>
    </Grid>
</Window>
