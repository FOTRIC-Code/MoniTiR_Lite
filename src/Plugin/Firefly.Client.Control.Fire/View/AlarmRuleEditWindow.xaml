<Window
    x:Class="Firefly.Client.Control.Fire.AlarmRuleEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    x:Name="root"
    Title="AlarmRuleEditControl"
    Width="480"
    MinWidth="480"
    MinHeight="600"
    SizeToContent="Height"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <control:ValidationRang
            x:Key="Alert1TimeRang"
            Maximum="200"
            Minimum="0"
            TargetType="system:Int32" />
        <control:ValidationRang
            x:Key="Alert2TimeRang"
            Maximum="200"
            Minimum="0"
            TargetType="system:Int32" />
        <control:ValidationRang
            x:Key="AlarmTimeRang"
            Maximum="200"
            Minimum="0"
            TargetType="system:Int32" />
        <control:ValidationRang
            x:Key="ToleranceTempRang"
            MaxDecimalLength="1"
            Maximum="100"
            Minimum="0"
            TargetType="system:Single" />
    </Window.Resources>
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader
            x:Name="PART_Title"
            Grid.Row="0"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1">
            <StackPanel
                Margin="{DynamicResource LeftRightBottomMargin}"
                HorizontalAlignment="Left"
                DockPanel.Dock="Top">
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        x:Name="twiName"
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.EntityName}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <ComboBox
                        Width="300"
                        HorizontalContentAlignment="Center"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding RuleTypeRange}"
                        SelectedIndex="{Binding RuleTypeIndex, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Type}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Alert1Temp, StringFormat={}{0:F1}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Alert1Temp}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Alert1FilteringTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource Alert1TimeRang}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Alert1FilteringTime}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Alert2Temp, StringFormat={}{0:F1}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Alert2Temp}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Alert2FilteringTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource Alert2TimeRang}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Alert2FilteringTime}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding AlarmTemp, StringFormat={}{0:F1}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.AlarmTemp}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding AlarmFilteringTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource AlarmTimeRang}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.AlarmFilteringTime}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding ToleranceTemp, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource ToleranceTempRang}}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.ToleranceTemp}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
            <StackPanel
                Margin="{StaticResource LargeMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="btNewRule"
                    Click="btnSave_Click"
                    Content="{x:Static lang:Resources.Save}"
                    IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
