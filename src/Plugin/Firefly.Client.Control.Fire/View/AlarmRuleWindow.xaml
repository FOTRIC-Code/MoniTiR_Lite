<Window x:Class="Firefly.Client.Control.Fire.AlarmRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
        xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
        x:Name="root"
        Style="{StaticResource ResizableDialogWindow}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
        Loaded="AlarmRuleControl_OnLoaded"
        Width="480" SizeToContent="Height" MinWidth="480" MinHeight="480">
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Grid.Row="0" Title="{x:Static lang:Resources.AlarmRule}" ResizeMode="{Binding ResizeMode,ElementName=root}" />
        <Border Grid.Row="1" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}" Margin="{DynamicResource TopMargin}">
            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="{DynamicResource LeftMargin}" amurControls:ButtonAssist.Image="pack://application:,,,/Resources/add_icon.png" BorderThickness="1" Content="{x:Static lang:Resources.Add}" VerticalAlignment="Top" Click="cbAddRule_Click" />
        </Border>
        <Grid Grid.Row="2" Margin="{DynamicResource LargeMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel DockPanel.Dock="Top">
                <DataGrid x:Name="dgRule" DockPanel.Dock="Right" SelectedIndex="0" HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Items}" amurControls:DataGridAssist.AutoRowNumber="True" CanUserAddRows="False" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static lang:Resources.Order}" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static lang:Resources.EntityName}" Width="270" IsReadOnly="True" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static lang:Resources.Operation}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="cbRuleEdit_Click" amurControls:ButtonAssist.Image="pack://application:,,,/Resources/edit_icon.png"></Button>
                                        <Rectangle Margin="{StaticResource NormalMargin}" />
                                        <Button Click="cbRuleDelete_Click" amurControls:ButtonAssist.Image="pack://application:,,,/Resources/delete_icon.png"></Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="{DynamicResource TopMargin}">
                <Button x:Name="btnUpload" IsDefault="True" Content="{x:Static lang:Resources.Save}" Click="btnUpload_Click" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button x:Name="btChoose" Content="{x:Static lang:Resources.Choose}" Click="btChoose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
