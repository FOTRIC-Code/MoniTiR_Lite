<TabItem
    x:Class="Firefly.Client.Control.Fire.CruiseRouteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.CruiseRoute}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <Grid Margin="{DynamicResource LeftMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  列表  -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <Border
                Margin="{DynamicResource BottomMargin}"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}"
                DockPanel.Dock="Top">
                <Button
                    HorizontalAlignment="Left"
                    amur:ButtonAssist.Image="pack://application:,,,/Resources/add_icon.png"
                    BorderThickness="1"
                    Click="btnAddRoute_Click"
                    Content="{x:Static lang:Resources.Add}"
                    Style="{StaticResource IRtek.Styles.Button.Classic}" />
            </Border>
            <DataGrid
                x:Name="dgCruiseRoute"
                amur:DataGridAssist.AutoRowNumber="True"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                SelectedIndex="0"
                SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Header="{x:Static lang:Resources.CruiseName}">
                        <DataGridTextColumn.CellStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.BeginStop}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                    <Button
                                        Margin="{StaticResource NormalMargin}"
                                        amur:ButtonAssist.Image="pack://application:,,,/Firefly.Client.Control.Fire;component/Resources/play_icon.png"
                                        Click="cbtnCruisePlay_Click" />
                                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                    <Button
                                        Margin="{StaticResource NormalMargin}"
                                        amur:ButtonAssist.Image="pack://application:,,,/Firefly.Client.Control.Fire;component/Resources/stop_icon.png"
                                        Click="cbtnCruisePause_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.Operation}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <amur:Button Margin="{StaticResource NormalMargin}" Click="cbtnCruiseDelete_Click">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Symbol="Delete20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                    <amur:Button Margin="{StaticResource NormalMargin}" Click="cbtnCruiseEdit_Click">
                                        <amur:Button.Icon>
                                            <amur:SymbolIcon Symbol="Edit20" />
                                        </amur:Button.Icon>
                                    </amur:Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Grid Grid.Column="1" Margin="{DynamicResource LeftMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="374" />
            </Grid.RowDefinitions>
            <!--  视频  -->
            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" BorderThickness="1,1,1,1" />
                        <control:RTSPClientControl
                            x:Name="irClient"
                            MinWidth="640"
                            MinHeight="480"
                            RTSPUrl="{Binding IRRTSPUrl}" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" BorderThickness="1,1,1,1" />
                        <control:RTSPClientControl
                            x:Name="dcClient"
                            MinWidth="640"
                            MinHeight="480"
                            RTSPUrl="{Binding DCRTSPUrl}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="1" Margin="{DynamicResource TopMargin}">
                <Grid.Resources>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <DataGrid
                    x:Name="dgPresets"
                    Grid.Row="1"
                    MinHeight="200"
                    amur:DataGridAssist.AutoRowNumber="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding SelectedItem.Presets}">
                    <DataGrid.Resources>
                        <control:ValidationRang
                            x:Key="StopTimeRang"
                            Maximum="600"
                            Minimum="1"
                            TargetType="system:Int32" />
                        <control:ValidationRang
                            x:Key="SpeedRang"
                            Maximum="10"
                            Minimum="0"
                            TargetType="system:Int32" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="300" Header="{x:Static lang:Resources.EntityName}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Path=WaitTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:F0}, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource StopTimeRang}}"
                            Header="{x:Static lang:Resources.WaitTime}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding Path=Speed, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:F0}, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource SpeedRang}}"
                            Header="{x:Static lang:Resources.Speed}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Height="32"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</TabItem>
