<Window
    x:Class="Firefly.Client.Control.Fire.CruiseRouteEditPresetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fire="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Width="480"
    Height="300"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{Binding Title}" ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <StackPanel
            Grid.Row="1"
            Margin="{DynamicResource LeftMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <ComboBox
                    Width="300"
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding PresetList, RelativeSource={RelativeSource AncestorType={x:Type fire:CruiseRouteEditPresetWindow}}}"
                    SelectedItem="{Binding SelectedPreset, RelativeSource={RelativeSource AncestorType={x:Type fire:CruiseRouteEditPresetWindow}}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Preset}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    Width="300"
                    DockPanel.Dock="Right"
                    Text="{Binding WaitTime}"
                    TextAlignment="Center" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.WaitTime}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <TextBox
                    Width="300"
                    DockPanel.Dock="Right"
                    Text="{Binding Speed}"
                    TextAlignment="Center" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Speed}"
                    TextAlignment="Right" />
            </DockPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" />
            <DockPanel>
                <CheckBox
                    Width="300"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding AutoFocus}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                <TextBlock
                    MinWidth="120"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.AutoFocus}"
                    TextAlignment="Right" />
            </DockPanel>
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="{DynamicResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.OK}" />
            <Rectangle Width="{DynamicResource IntervalsWidth}" />
            <Button
                x:Name="btnCancel"
                Click="btnCancel_Click"
                Content="{x:Static lang:Resources.Cancel}" />
        </StackPanel>
    </Grid>
</Window>
