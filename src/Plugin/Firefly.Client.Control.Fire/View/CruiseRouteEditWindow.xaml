<Window
    x:Class="Firefly.Client.Control.Fire.CruiseRouteEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    x:Name="root"
    Width="800"
    MinWidth="600"
    MinHeight="500"
    SizeToContent="Height"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{Binding Title}" ResizeMode="{Binding ResizeMode, ElementName=root}" />

        <DockPanel Grid.Row="1" Margin="{DynamicResource LargeMargin}">
            <StackPanel
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Center" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        Margin="{DynamicResource LeftMargin}"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.CruiseName}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
            <Border
                Margin="{DynamicResource TopMargin}"
                Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
                DockPanel.Dock="Top">
                <Button
                    Margin="{DynamicResource LargeMargin}"
                    HorizontalAlignment="Right"
                    amurControls:ButtonAssist.Image="pack://application:,,,/Resources/add_icon.png"
                    BorderThickness="1"
                    Click="cbtnAddPreset_Click"
                    Content="{x:Static lang:Resources.Add}"
                    Style="{StaticResource IRtek.Styles.Button.Classic}" />
            </Border>
            <StackPanel
                Margin="{DynamicResource TopMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="btnSave"
                    Click="btnSave_Click"
                    Content="{x:Static lang:Resources.Save}"
                    IsDefault="True">
                    <Button.Style>
                        <Style BasedOn="{StaticResource IRtek.Styles.Button.Classic}" TargetType="{x:Type Button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button
                    x:Name="btnCancel"
                    Click="btnCancel_Click"
                    Content="{x:Static lang:Resources.Cancel}" />
            </StackPanel>
            <DataGrid
                x:Name="dgPresets"
                Grid.Row="1"
                amurControls:DataGridAssist.AutoRowNumber="True"
                DockPanel.Dock="Top"
                IsReadOnly="True"
                ItemsSource="{Binding Presets}">
                <DataGrid.Resources>
                    <control:ValidationRang
                        x:Key="StopTimeRang"
                        Maximum="600"
                        Minimum="1"
                        TargetType="system:Int32" />
                    <control:ValidationRang
                        x:Key="SpeedRang"
                        Maximum="10"
                        Minimum="0"
                        TargetType="system:Int32" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="200" Header="{x:Static lang:Resources.EntityName}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Left" Text="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Path=WaitTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:F0}, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource StopTimeRang}}"
                        Header="{x:Static lang:Resources.WaitTime}" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Path=Speed, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:F0}, Converter={StaticResource ValidationConverter}, ConverterParameter={StaticResource SpeedRang}}"
                        Header="{x:Static lang:Resources.Speed}" />
                    <DataGridTemplateColumn Width="140" Header="{x:Static lang:Resources.Operation}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <amurControls:Button Click="cbtMarkerEdit_Click">
                                        <amurControls:Button.Icon>
                                            <amurControls:SymbolIcon Symbol="Edit20" />
                                        </amurControls:Button.Icon>
                                    </amurControls:Button>
                                    <amurControls:Button Click="cbtnPresetDelete_Click">
                                        <amurControls:Button.Icon>
                                            <amurControls:SymbolIcon Symbol="Delete20" />
                                        </amurControls:Button.Icon>
                                    </amurControls:Button>
                                    <amurControls:Button Click="cbtnPresetMoveUp_Click">
                                        <amurControls:Button.Icon>
                                            <amurControls:SymbolIcon Symbol="ArrowUp20" />
                                        </amurControls:Button.Icon>
                                    </amurControls:Button>
                                    <amurControls:Button Click="cbtnPresetMoveDown_Click">
                                        <amurControls:Button.Icon>
                                            <amurControls:SymbolIcon Symbol="ArrowDown20" />
                                        </amurControls:Button.Icon>
                                    </amurControls:Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
