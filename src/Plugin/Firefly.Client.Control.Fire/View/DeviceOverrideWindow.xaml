<Window
    x:Class="Firefly.Client.Control.Fire.DeviceOverrideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="CopyWindow"
    Width="680"
    Loaded="DeviceOverrideWindow_OnLoaded"
    Height="540"
    MinWidth="480"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader
            x:Name="title"
            Title="{x:Static lang:Resources.CopyTo}"
            ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1" Margin="{DynamicResource LargeMargin}">
            <StackPanel
                Margin="{DynamicResource TopMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    Click="btnOK_Click"
                    Content="{x:Static lang:Resources.OK}"
                    IsDefault="True"
                    IsEnabled="{Binding HasSelectedItem}" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button Click="btnCancel_Click" Content="{x:Static lang:Resources.Cancel}" />
            </StackPanel>
            <Rectangle Height="{DynamicResource IntervalsHeight}" DockPanel.Dock="Bottom" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <DataGrid HeadersVisibility="None" ItemsSource="{Binding ConfigItems}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Width="60"
                            Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                            CanUserSort="False" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding ConfigName}"
                            CanUserSort="False"
                            Header="{x:Static lang:Resources.DeviceName}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid
                    Grid.Column="1"
                    Margin="{DynamicResource LeftMargin}"
                    ItemsSource="{Binding DeviceItems}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Width="60"
                            Binding="{Binding IsDeviceChecked, UpdateSourceTrigger=PropertyChanged}"
                            CanUserSort="False">
                            <DataGridCheckBoxColumn.HeaderStyle>
                                <Style BasedOn="{StaticResource IRtek.Styles.DataGridColumnHeader.Classic}" TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Margin" Value="17,0,0,0" />
                                </Style>
                            </DataGridCheckBoxColumn.HeaderStyle>
                            <DataGridCheckBoxColumn.CellStyle>
                                <Style BasedOn="{StaticResource IRtek.Styles.DataGridCell.Classic}" TargetType="{x:Type DataGridCell}">
                                    <EventSetter Event="CheckBox.Click" Handler="cb_OnClick" />
                                </Style>
                            </DataGridCheckBoxColumn.CellStyle>
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            Click="cb_OnClick"
                                            IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.IsSelectedAll, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding DeviceName}"
                            CanUserSort="False"
                            Header="{x:Static lang:Resources.DeviceName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
