<TabItem
    x:Class="Firefly.Client.Control.Fire.EventTriggerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.EventTrigger}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <TabItem.Resources>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBoxItem.Classic}" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style BasedOn="{StaticResource IRtek.Styles.ListBox.Classic}" TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type local:EventTriggerItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Margin="{StaticResource NormalMargin}" />
                            <CheckBox
                                x:Name="cbOut"
                                Content="{Binding Name}"
                                IsChecked="{Binding IsChecked}" />
                            <Rectangle Margin="{StaticResource NormalMargin}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </TabItem.Resources>
    <Grid Margin="{DynamicResource LeftMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" />
        <UniformGrid
            Grid.Row="0"
            Width="400"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Columns="1"
            Rows="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.Alarm1Output}" />
                <ListBox
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Alert1Outs}" />
            </Grid>
            <Rectangle Margin="{StaticResource NormalMargin}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.Alarm2Output}" />
                <ListBox
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Alert2Outs}" />
            </Grid>
            <Rectangle Margin="{StaticResource NormalMargin}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.EventTriggerOutput}" />
                <ListBox
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding AlarmOuts}" />
            </Grid>
        </UniformGrid>
        <StackPanel
            Grid.Row="2"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btSave"
                Height="32"
                Click="btSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</TabItem>
