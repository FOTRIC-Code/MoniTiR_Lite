<Window x:Class="Firefly.Client.Control.Fire.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
        xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
        xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
        mc:Ignorable="d" Style="{StaticResource ResizableDialogWindow}"
        x:Name="root" Title="{x:Static lang:Resources.Export}" 
        Width="480" MinWidth="480" MinHeight="400"
        ResizeMode="NoResize" SizeToContent="Height"
        AllowsTransparency="False" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Grid.Row="0" x:Name="title" Title="{Binding ElementName=root, Path=Title}" />
        <DockPanel Grid.Row="1" Margin="{DynamicResource LargeMargin}">
            <Button DockPanel.Dock="Bottom" Content="{x:Static lang:Resources.Export}" HorizontalAlignment="Right" Click="btnExport_Click" />
            <Rectangle DockPanel.Dock="Bottom" Height="{DynamicResource IntervalsHeight}" />
            <TextBox DockPanel.Dock="Top" Height="300" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" TextWrapping="Wrap" x:Name="tbExport" HorizontalContentAlignment="Left" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        </DockPanel>
    </Grid>
</Window>
