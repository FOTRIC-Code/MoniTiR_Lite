<TabItem
    x:Class="Firefly.Client.Control.Fire.GeneralControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.General}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Margin="{DynamicResource LeftMargin}" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid
                Margin="{DynamicResource TopMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" MinWidth="240" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="auto" MinWidth="200" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.SampleInterval}"
                    TextAlignment="Right" />
                <TextBox
                    x:Name="tbSampleInterval"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource BottomMargin}"
                    Text="{Binding SampleInterval}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.DataRecordEnabled}"
                    TextAlignment="Right" />
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding DataRecordEnabled}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.DataRecordInterval}"
                    TextAlignment="Right" />
                <TextBox
                    x:Name="tbDataRecordInterval"
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="{StaticResource BottomMargin}"
                    IsEnabled="{Binding DataRecordEnabled}"
                    Text="{Binding DataRecordInterval}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ImageRecordEnable}"
                    TextAlignment="Right" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="{StaticResource BottomMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ImageRecordEnabled}"
                    IsEnabled="{Binding DataRecordEnabled}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.ImageRecordInterval}"
                    TextAlignment="Right" />
                <TextBox
                    x:Name="tbImageRecordInterval"
                    Grid.Row="2"
                    Grid.Column="3"
                    Margin="{StaticResource BottomMargin}"
                    IsEnabled="{Binding ImageRecordEnabled}"
                    Text="{Binding ImageRecordInterval}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.EnableSuperResolution}"
                    TextAlignment="Right" />
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="{StaticResource BottomMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding EnableSuperResolution}" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="{StaticResource BottomMargin}"
                    VerticalAlignment="Center"
                    Text="{x:Static lang:Resources.PointMonitorEnable}"
                    TextAlignment="Right" />
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="{StaticResource BottomMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding FixedMonitoring}" />
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Height="32"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True"
                Style="{StaticResource IRtek.Styles.Button.Classic}" />
        </StackPanel>
    </Grid>
</TabItem>
