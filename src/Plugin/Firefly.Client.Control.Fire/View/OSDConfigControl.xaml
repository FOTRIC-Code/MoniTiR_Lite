<TabItem
    x:Class="Firefly.Client.Control.Fire.OSDConfigControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    Header="{x:Static lang:Resources.CharacterOverlay}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <Grid Margin="{DynamicResource LeftMargin}" IsEnabled="{Binding Enable}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" Orientation="Vertical">
                <StackPanel Margin="{DynamicResource LeftTopMargin}" Orientation="Horizontal">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Text="{x:Static lang:Resources.EnableOSD}"
                        TextAlignment="Right" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    <CheckBox HorizontalAlignment="Left" IsChecked="{Binding EnableOSD}" />
                </StackPanel>
                <StackPanel Margin="{DynamicResource LeftTopMargin}" Orientation="Horizontal">
                    <control:OSDConfigGrid
                        x:Name="PART_osd"
                        Grid.Row="1"
                        Grid.RowSpan="7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ChannelOSD="{Binding ChannelOSD, Mode=OneWay}"
                        EnableOSD="{Binding EnableOSD}"
                        PTZOSD="{Binding PTZOSD, Mode=OneWay}"
                        PositionChanged="osd_PositionChanged"
                        RTSPUrl="{Binding RTSPUrl}"
                        TimeOSD="{Binding TimeOSD, Mode=OneWay}" />
                    <StackPanel Margin="{DynamicResource LeftMargin}" Orientation="Vertical">
                        <DockPanel>
                            <TextBox
                                Width="200"
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Right"
                                IsEnabled="{Binding EnableChannelName}"
                                KeyDown="tbChannelName_KeyDown"
                                Text="{Binding Name}"
                                TextAlignment="Left" />
                            <CheckBox
                                Width="100"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowChannel}"
                                IsEnabled="{Binding EnableOSD}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowChannelName}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowTime}"
                                IsEnabled="{Binding EnableOSD}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowTime}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowPTZ}"
                                IsEnabled="{Binding EnableOSD}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowPresetName}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowTemp}"
                                IsEnabled="{Binding EnableOSD}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowMarkerTemp}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowMax}"
                                IsEnabled="{Binding EnableShowMax}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowMax}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowMin}"
                                IsEnabled="{Binding EnableShowMin}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowMin}"
                                TextAlignment="Right" />
                        </DockPanel>
                        <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        <DockPanel>
                            <CheckBox
                                Width="300"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ShowAvg}"
                                IsEnabled="{Binding EnableShowAvg}" />
                            <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                            <TextBlock
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Left"
                                Text="{x:Static lang:Resources.ShowAvg}"
                                TextAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Height="32"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</TabItem>