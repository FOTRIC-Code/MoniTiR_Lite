<TabItem
    x:Class="Firefly.Client.Control.Fire.PresetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:local="clr-namespace:Firefly.Client.Control.Fire"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:service="clr-namespace:Firefly.Client.Service;assembly=Firefly.Client.Service"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    Header="{x:Static lang:Resources.Preset}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    Unloaded="PresetControl_Unloaded"
    mc:Ignorable="d">
    <Grid Margin="{DynamicResource LeftMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  预置位列表  -->
        <DataGrid
            x:Name="dgPreset"
            Grid.Column="0"
            Width="280"
            amur:DataGridAssist.AutoRowNumber="True"
            amur:DataGridAssist.RowNumberFormat="{x:Static lang:Resources.PresetIndex}"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            PreviewMouseDown="dgPreset_PreviewMouseDown"
            SelectedValue="{Binding SelectedItem}"
            SelectionChanged="dgPreset_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="160" Header="{x:Static lang:Resources.PresetName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.PresetControl}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Margin="{StaticResource NormalMargin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                amur:ButtonAssist.Image="pack://application:,,,/Resources/delete_icon.png"
                                Click="cbtnPresetClear_Click"
                                IsEnabled="{Binding IsUsed}"
                                Tag="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="{DynamicResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btSave"
                Height="32"
                Click="btSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            Margin="{DynamicResource LeftMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="374" />
            </Grid.RowDefinitions>
            <!--  视频  -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" />
                        <control:RTSPClientControl
                            x:Name="irClient"
                            MinWidth="640"
                            MinHeight="480"
                            DeviceArea="{Binding DeviceArea}"
                            MarkerAdded="dpcCanvas_MarkerAdded"
                            MarkerChanged="dpcCanvas_MarkerChanged"
                            MarkerList="{Binding SelectedItem.BindingCanvasMarkerList, Mode=OneWay}"
                            MaskList="{Binding SelectedItem.BindingCanvasShieldMaskList, Mode=OneWay}"
                            RTSPUrl="{Binding IRRTSPUrl}"
                            SelectChanged="dpcCanvas_SelectChanged" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Border Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}" />
                        <control:RTSPClientControl
                            x:Name="dcClient"
                            MinWidth="640"
                            MinHeight="480"
                            RTSPUrl="{Binding DCRTSPUrl}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
            <!--  列表与操作盘  -->
            <ScrollViewer
                Grid.Row="1"
                Margin="{DynamicResource TopMargin}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid Grid.Row="1" Margin="{DynamicResource TopMargin}">
                    <Grid.Resources>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  列表  -->
                    <Grid Grid.Column="0">
                        <TabControl
                            Grid.Column="1"
                            SelectionChanged="tabControl_SelectionChanged"
                            TabStripPlacement="Left">
                            <TabItem
                                x:Name="ctiShield"
                                Width="{StaticResource DefaultTabItemWidth}"
                                Header="{x:Static lang:Resources.ShieldMasks}">
                                <Grid Margin="{DynamicResource LeftMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Margin="{DynamicResource BottomMargin}" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}">
                                        <Button
                                            Margin="{DynamicResource LeftMargin}"
                                            HorizontalAlignment="Left"
                                            amur:ButtonAssist.Image="pack://application:,,,/Resources/add_icon.png"
                                            BorderThickness="1"
                                            Click="cbShieldsAdd_Click"
                                            Content="{x:Static lang:Resources.Add}" />
                                    </Border>
                                    <DataGrid
                                        x:Name="dgShieldMasks"
                                        Grid.Row="1"
                                        amur:DataGridAssist.AutoRowNumber="True"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedItem.BindingGridShieldMaskList}"
                                        SelectionChanged="dgShieldMasks_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn
                                                Width="240"
                                                Binding="{Binding Name}"
                                                Header="{x:Static lang:Resources.AreaName}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Width="80" Header="{x:Static lang:Resources.Operation}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                amur:ButtonAssist.Image="pack://application:,,,/Resources/edit_icon.png"
                                                                Click="cbtShieldMaskEdit_Click" />
                                                            <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                                            <Button
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                amur:ButtonAssist.Image="pack://application:,,,/Resources/delete_icon.png"
                                                                Click="cbShieldMasksDelete_Click" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem
                                x:Name="ctiMarker"
                                Width="{StaticResource DefaultTabItemWidth}"
                                Header="{x:Static lang:Resources.Markers}">
                                <Grid Margin="{DynamicResource LeftMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Margin="{DynamicResource BottomMargin}" Background="{DynamicResource IRtek.Brushes.ThemeBackground.Toolbar}">
                                        <Button
                                            x:Name="btnAddMarker"
                                            Margin="{DynamicResource LeftMargin}"
                                            HorizontalAlignment="Left"
                                            amur:ButtonAssist.Image="pack://application:,,,/Resources/add_icon.png"
                                            BorderThickness="1"
                                            Click="cbMarkersAdd_Click"
                                            Content="{x:Static lang:Resources.Add}" />
                                    </Border>
                                    <Popup
                                        x:Name="popMarkerType"
                                        Grid.Row="0"
                                        Width="100"
                                        Placement="Top"
                                        PlacementTarget="{Binding ElementName=btnAddMarker}"
                                        VerticalOffset="-3">
                                        <ListBox
                                            x:Name="ltbMarkerType"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            SelectionChanged="ltbMarkerType_SelectionChanged">
                                            <ListBoxItem Tag="{x:Static control:MarkerType.Spot}">
                                                <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.Spot}" />
                                            </ListBoxItem>
                                            <ListBoxItem Tag="{x:Static control:MarkerType.Line}">
                                                <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.Line}" />
                                            </ListBoxItem>
                                            <ListBoxItem Tag="{x:Static control:MarkerType.Region}">
                                                <TextBlock HorizontalAlignment="Center" Text="{x:Static lang:Resources.Region}" />
                                            </ListBoxItem>
                                        </ListBox>
                                    </Popup>
                                    <DataGrid
                                        x:Name="dgMarker"
                                        Grid.Row="1"
                                        amur:DataGridAssist.AutoRowNumber="True"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedItem.BindingGridMarkerList}"
                                        SelectionChanged="dgMarker_SelectionChanged">
                                        <DataGrid.Resources>
                                            <local:EnumToStringConverter x:Key="EnumToStringConverter" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="70" Header="{x:Static lang:Resources.Order}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type DataGridRow}}, Path=Header}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding MarkerType, Converter={StaticResource EnumToStringConverter}}"
                                                Header="{x:Static lang:Resources.Type}" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding Name}"
                                                Header="{x:Static lang:Resources.EntityName}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding Name}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding Emissivity, StringFormat={}{0:N2}}"
                                                Header="{x:Static lang:Resources.Emissivity}" />
                                            <DataGridTextColumn
                                                Width="120"
                                                Binding="{Binding Distance, StringFormat={}{0:N2}}"
                                                Header="{x:Static lang:Resources.Distance}" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding RelTemp, StringFormat={}{0:N1}}"
                                                Header="{x:Static lang:Resources.RelTemp}" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding OffsetTemp, StringFormat={}{0:N1}}"
                                                Header="{x:Static lang:Resources.OffsetTemp}" />
                                            <DataGridTemplateColumn Width="100" Header="{x:Static lang:Resources.AlarmRule}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            Foreground="{StaticResource LinkBlue}"
                                                            MouseLeftButtonUp="tbFireAlarm_MouseLeftButtonUp"
                                                            Text="{Binding AlarmRuleName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding AlarmRuleName}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="80" Header="{x:Static lang:Resources.Operation}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                amur:ButtonAssist.Image="pack://application:,,,/Resources/edit_icon.png"
                                                                Click="cbtMarkerEdit_Click" />
                                                            <Rectangle Width="{DynamicResource IntervalsWidth}" />
                                                            <Button
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                amur:ButtonAssist.Image="pack://application:,,,/Resources/delete_icon.png"
                                                                Click="cbMarkersDelete_Click" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <!--  操作盘  -->
                    <Grid
                        Grid.Column="1"
                        Margin="{DynamicResource LeftMargin}"
                        Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  描述 灵敏度  -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="{DynamicResource TopMargin}"
                            HorizontalAlignment="Center"
                            Orientation="Vertical">
                            <DockPanel>
                                <TextBox
                                    Width="130"
                                    DockPanel.Dock="Right"
                                    Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    TextAlignment="Center" />
                                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                                <TextBlock
                                    MinWidth="100"
                                    DockPanel.Dock="Left"
                                    Text="{x:Static lang:Resources.Describe}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}" />
                            </DockPanel>
                            <Rectangle Height="{DynamicResource IntervalsHeight}" />
                            <DockPanel>
                                <ComboBox
                                    Width="130"
                                    HorizontalContentAlignment="Center"
                                    DockPanel.Dock="Right"
                                    ItemsSource="{Binding SelectedItem.SensitivityRange}"
                                    SelectedIndex="{Binding SelectedItem.SensitivityIndex}" />
                                <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                                <TextBlock
                                    MinWidth="100"
                                    DockPanel.Dock="Left"
                                    Text="{x:Static lang:Resources.Sensitivity}"
                                    TextAlignment="Right"
                                    ToolTip="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}" />
                            </DockPanel>
                            <Rectangle Height="{DynamicResource IntervalsHeight}" />
                        </StackPanel>

                        <!--  操作部分  -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  热像调焦 自动对焦  -->
                            <Grid Grid.Row="0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="btnFireFocusDown"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    amur:ButtonAssist.Image="/Firefly.Client.Control.Fire;component/Resources/focus_down_icon.png"
                                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                                    Tag="{x:Static service:PTZCommand.FOCUS_NEAR}"
                                    ToolTip="{x:Static lang:Resources.Focus}" />
                                <Button
                                    x:Name="btnAutoFocus"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    amur:ButtonAssist.Image="/Firefly.Client.Control.Fire;component/Resources/auto_focus_icon.png"
                                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                                    Tag="{x:Static service:PTZCommand.FOCUS_AUTO}"
                                    ToolTip="{x:Static lang:Resources.AutoFocus}" />
                                <Button
                                    x:Name="btnFireFocusUp"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    amur:ButtonAssist.Image="/Firefly.Client.Control.Fire;component/Resources/focus_up_icon.png"
                                    PreviewMouseLeftButtonDown="btnIRCameraPresetControl_MouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="btnIRCameraPresetControl_MouseLeftButtonUp"
                                    Tag="{x:Static service:PTZCommand.FOCUS_FAR}"
                                    ToolTip="{x:Static lang:Resources.Focus}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="{StaticResource NormalMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  云台操作  -->

                                <control:WheelControl
                                    Grid.Column="0"
                                    Width="138"
                                    Height="138"
                                    MouseLeftButtonDown="WheelControl_MouseLeftButtonDown"
                                    MouseLeftButtonUp="WheelControl_MouseLeftButtonUp" />
                                <Slider
                                    x:Name="sldSpeed"
                                    Grid.Column="1"
                                    Width="20"
                                    Height="130"
                                    HorizontalAlignment="Center"
                                    Maximum="10"
                                    Minimum="1"
                                    Orientation="Vertical"
                                    Style="{StaticResource VerticalSlider}"
                                    Value="5" />
                            </Grid>
                            <!--  对焦 光圈 变倍  -->
                            <Grid
                                Grid.Row="3"
                                Margin="{DynamicResource BottomMargin}"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding HasVisualVideo}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <Button
                                        x:Name="btnVisionFocusUp"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/focus_up_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.FOCUS_FAR}"
                                        ToolTip="{x:Static lang:Resources.Focus}" />
                                    <Rectangle Margin="{StaticResource LargeMargin}" />
                                    <Button
                                        x:Name="btnVisionFocusDown"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/focus_down_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.FOCUS_NEAR}"
                                        ToolTip="{x:Static lang:Resources.Focus}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <Button
                                        x:Name="btnVisionLightUp"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/aperture_up_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.IRIS_OPEN}"
                                        ToolTip="{x:Static lang:Resources.Aperture}" />
                                    <Rectangle Margin="{StaticResource LargeMargin}" />
                                    <Button
                                        x:Name="btnVisionLightDown"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/aperture_down_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.IRIS_OPEN}"
                                        ToolTip="{x:Static lang:Resources.Aperture}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical">
                                    <Button
                                        x:Name="btnVisionTimesUp"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/zoom_up_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.ZOOM_IN}"
                                        ToolTip="{x:Static lang:Resources.Zoom}" />
                                    <Rectangle Margin="{StaticResource LargeMargin}" />
                                    <Button
                                        x:Name="btnVisionTimesDown"
                                        amur:ButtonAssist.Image="pack://application:,,,/Resources/zoom_down_icon.png"
                                        PreviewMouseLeftButtonDown="btnDCCameraPresetControl_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="btnDCCameraPresetControl_MouseLeftButtonUp"
                                        Tag="{x:Static service:PTZCommand.ZOOM_OUT}"
                                        ToolTip="{x:Static lang:Resources.Zoom}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>


        </Grid>
    </Grid>
</TabItem>
