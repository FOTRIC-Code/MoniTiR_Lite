<Window
    x:Class="Firefly.Client.Control.Fire.PresetMarkerEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
    xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Width="480"
    MinWidth="480"
    MinHeight="410"
    SizeToContent="Height"
    Style="{StaticResource ResizableDialogWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{Binding Title, Mode=OneTime}" ResizeMode="{Binding ResizeMode, ElementName=root}" />
        <DockPanel Grid.Row="1">
            <StackPanel
                Margin="{DynamicResource LeftRightBottomMargin}"
                HorizontalAlignment="Left"
                DockPanel.Dock="Top"
                Orientation="Vertical">
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel IsEnabled="false">
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding MarkTypeText, Mode=OneTime}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Type}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Name}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.AreaName}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Emissivity}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Emissivity}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding Distance}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.Distance}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding RelTemp}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.RelTemp}"
                        TextAlignment="Right" />
                </DockPanel>
                <Rectangle Height="{DynamicResource IntervalsHeight}" />
                <DockPanel>
                    <TextBox
                        Width="300"
                        DockPanel.Dock="Right"
                        Text="{Binding OffsetTemp}" />
                    <Rectangle Width="{DynamicResource IntervalsWidth}" DockPanel.Dock="Right" />
                    <TextBlock
                        MinWidth="120"
                        DockPanel.Dock="Left"
                        Text="{x:Static lang:Resources.OffsetTemp}"
                        TextAlignment="Right" />
                </DockPanel>
            </StackPanel>

            <StackPanel
                Margin="{DynamicResource LargeMargin}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    x:Name="btnSave"
                    Click="btnSave_Click"
                    Content="{x:Static lang:Resources.OK}"
                    IsDefault="True" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button
                    x:Name="btnCancel"
                    Click="btnCancel_Click"
                    Content="{x:Static lang:Resources.Cancel}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
