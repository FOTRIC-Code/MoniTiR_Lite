<Window x:Class="Firefly.Client.Control.Fire.PresetShieldMaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
        xmlns:control="clr-namespace:Firefly.Client.Control;assembly=Firefly.Client.Control"
        xmlns:amurControls="clr-namespace:Amur.Controls;assembly=Amur.Controls"
        x:Name="root"
        mc:Ignorable="d" Style="{StaticResource ResizableDialogWindow}"
        WindowStartupLocation="CenterScreen"
        Height="170" Width="500" MinHeight="160" MinWidth="460">
    <Grid Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <amurControls:IRtekWindowHeader Title="{Binding Title, Mode=OneTime}" ResizeMode="{Binding ResizeMode,ElementName=root}" />
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="{DynamicResource LargeMargin}">
                <Button x:Name="btnSave" IsDefault="True" Content="{x:Static lang:Resources.OK}" Click="btnSave_Click" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <Button x:Name="btnCancel" Content="{x:Static lang:Resources.Cancel}" Click="btnCancel_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{DynamicResource TopMargin}">
                <TextBlock Text="{x:Static lang:Resources.AreaName}" MinWidth="120" TextAlignment="Right" />
                <Rectangle Width="{DynamicResource IntervalsWidth}" />
                <TextBox Width="300" Height="35" Text="{Binding Name}" TextAlignment="Center" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
