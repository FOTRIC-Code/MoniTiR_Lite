<TabItem
    x:Class="Firefly.Client.Control.Fire.TaskScheduleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:amur="http://schemas.amur.com/amur/2022/xaml"
    xmlns:control="http://schemas.fireflyclient.com/control/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Firefly.Client.I18n.Properties;assembly=Firefly.Client.I18n"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Width="{StaticResource DefaultTabItemWidth}"
    amur:TabItemAssist.Icon="{control:SymbolIcon Config}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="{x:Static lang:Resources.TaskSchedule}"
    Style="{StaticResource IRtek.Styles.TabItem.Classic}"
    mc:Ignorable="d">
    <Grid d:IsHidden="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Margin="{DynamicResource LeftMargin}"
            Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <Grid
                    Height="40"
                    Margin="{DynamicResource LeftMargin}"
                    Background="{DynamicResource IRtek.Brushes.ThemeBackground.Content}">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{x:Static lang:Resources.Enable}"
                            IsChecked="{Binding Enabled}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <TextBlock Text="{x:Static lang:Resources.RestoreTime}" />
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <TextBox
                            x:Name="tbRestoreTime"
                            Width="100"
                            Height="32"
                            IsEnabled="{Binding Enabled}"
                            Text="{Binding Path=RestoreTime, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <amur:Button
                            x:Name="btn_delete"
                            Height="32"
                            BorderThickness="1"
                            Click="btn_delete_Click"
                            Content="{x:Static lang:Resources.Delete}"
                            IsEnabled="{Binding HasSelectedItem}">
                            <amur:Button.Icon>
                                <control:SymbolIcon FontSize="18" Symbol="Delete" />
                            </amur:Button.Icon>
                        </amur:Button>
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                        <amur:Button
                            x:Name="btn_delete_all"
                            Height="32"
                            BorderThickness="1"
                            Click="btn_delete_all_Click"
                            Content="{x:Static lang:Resources.DeleteAll}"
                            IsEnabled="{Binding HasItem}">
                            <amur:Button.Icon>
                                <control:SymbolIcon FontSize="18" Symbol="Delete" />
                            </amur:Button.Icon>
                        </amur:Button>
                        <Rectangle Width="{DynamicResource IntervalsWidth}" />
                    </StackPanel>
                </Grid>
                <Border Height="8" Background="{DynamicResource IRtek.Brushes.ThemeBackground.WorkArea}" />
                <StackPanel
                    x:Name="sp_day_of_week"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding Enabled}"
                    Orientation="Vertical">
                    <control:DayGrid
                        x:Name="dpvMonday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding MondayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvTuesday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding TuesdayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvWednesday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding WednesdayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvThursday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding ThursdayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvFriday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding FridayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvSaturday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding SaturdayDataSource}" />
                    <control:DayGrid
                        x:Name="dpvSunday"
                        ItemStatusChanged="DayGrid_ItemStatusChanged"
                        MaxDurationCount="10"
                        MouseDown="DayGrid_MouseDown"
                        OverrideButtonClick="DayGrid_OverrideButtonClick"
                        Source="{Binding SundayDataSource}" />
                </StackPanel>
                <control:DayOverride x:Name="PART_day_override" SaveClick="PART_day_override_SaveClick" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="{StaticResource LargeMargin}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Height="32"
                Click="btnSave_Click"
                Content="{x:Static lang:Resources.Save}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</TabItem>
